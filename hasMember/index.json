  "notToBeConfusedWith": [
    "urn:solid:member"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "vCard's group-membership predicate. Distinct from `urn:solid:member` (FOAF) only by namespace; functionally the same. Use `hasMember` in vCard-flavored data, `member` in FOAF-flavored data. Repeat for multiple members.",
  "examples": [
    {
      "title": "vCard Group with members",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/groups/admins-vcard",
        "@type": "http://www.w3.org/2006/vcard/ns#Group",
        "urn:solid:hasMember": [
          { "@id": "https://example.org/cards/alice" },
          { "@id": "https://example.org/cards/bob" }
        ]
      }
    }
  ],
