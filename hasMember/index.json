{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:hasMember",
  "@type": "rdf:Property",
  "rdfs:label": "hasMember",
  "rdfs:comment": "A member of the vCard Group.",
  "owl:sameAs": "http://www.w3.org/2006/vcard/ns#hasMember",
  "rdfs:seeAlso": [
    "urn:solid:member",
    "urn:solid:AddressBook",
    "https://schema.org/member"
  ],
