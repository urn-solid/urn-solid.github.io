{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:label",
  "@type": "rdf:Property",
  "rdfs:label": "label",
  "rdfs:comment": "A human-readable name for a resource — short, plain text, suitable for UI display.",
  "owl:sameAs": "http://www.w3.org/2000/01/rdf-schema#label",
  "rdfs:seeAlso": [
    "urn:solid:name",
    "urn:solid:prefLabel",
    "urn:solid:title"
  ],
  "notToBeConfusedWith": [
    "urn:solid:name",
    "urn:solid:prefLabel"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "The most-general human-name predicate in RDF. For people prefer `foaf:name` (mapped to `urn:solid:name`); for SKOS Concepts prefer `skos:prefLabel`; for documents prefer `dcterms:title`. Use `rdfs:label` for everything else (vocabulary terms, classes, properties, opaque resources).",
  "examples": [
    {
      "title": "Labelling a class",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://example.org/vocab/Athlete",
        "@type": "urn:solid:Class",
        "urn:solid:label": "Athlete"
      }
    }
  ],
  "provenance": {
