{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:isMemberOfRelation",
  "@type": "rdf:Property",
  "rdfs:label": "isMemberOfRelation",
  "rdfs:comment": "The predicate the server adds in the *inverse* direction when a new resource is POSTed to a DirectContainer or IndirectContainer.",
  "owl:sameAs": "http://www.w3.org/ns/ldp#isMemberOfRelation",
  "rdfs:seeAlso": [
    "urn:solid:hasMemberRelation",
    "urn:solid:DirectContainer"
  ],
  "rdfs:domain": "urn:solid:Container",
  "notToBeConfusedWith": [
    "urn:solid:hasMemberRelation"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Inverse-direction equivalent of `ldp:hasMemberRelation`: instead of `<membershipResource> <pred> <new>`, the server adds `<new> <pred> <membershipResource>`. Use whichever direction matches your data model. A container declares one of `hasMemberRelation` or `isMemberOfRelation`, not both.",
  "examples": [
    {
      "title": "DirectContainer using the inverse direction",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://example.org/team/members/",
        "@type": "urn:solid:DirectContainer",
        "urn:solid:membershipResource": { "@id": "https://example.org/team" },
        "urn:solid:isMemberOfRelation": { "@id": "https://schema.org/memberOf" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/ldp#isMemberOfRelation"
    ],
