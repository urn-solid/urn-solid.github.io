{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:ContactPoint",
  "@type": "rdfs:Class",
  "rdfs:label": "ContactPoint",
  "rdfs:comment": "A contact point for a person or organization — an aggregation of reachable contact channels for a specific purpose or department.",
  "owl:sameAs": "https://schema.org/ContactPoint",
  "rdfs:seeAlso": [
    "urn:solid:email",
    "urn:solid:telephone",
    "urn:solid:hasEmail",
    "urn:solid:hasTelephone",
    "http://www.w3.org/2006/vcard/ns#VCard"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Use to bundle multiple contact channels (email + phone + hours + language) under a single descriptive label like \"customer support\" or \"press inquiries\". For a vCard-style structured contact, the equivalent base is `vcard:VCard`.",
  "examples": [
    {
      "title": "Customer support contact point",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/acme/contact/support",
        "@type": "urn:solid:ContactPoint",
        "https://schema.org/contactType": "customer support",
        "https://schema.org/email": "support@example.org",
        "https://schema.org/telephone": "+1-555-0123"
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://schema.org/ContactPoint"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-18T00:00:00Z",
