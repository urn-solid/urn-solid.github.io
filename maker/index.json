  "status": "stable",
  "added": "2026-04-18",
  "notes": "Use on a document or work to point at the agent that made it. The inverse `urn:solid:made` goes the other direction (agent → work). foaf:maker is the lightweight FOAF form. dcterms:creator (`urn:solid:creator`) is the usual choice for bibliographic and document metadata; for role and contribution detail use `prov:wasAttributedTo`.",
  "examples": [
    {
      "title": "Document with a maker",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/posts/hello",
        "@type": "urn:solid:Document",
        "urn:solid:maker": { "@id": "https://example.org/alice#me" }
      }
    }
  ],
