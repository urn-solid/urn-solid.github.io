{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Membership",
  "@type": "rdfs:Class",
  "rdfs:label": "Membership",
  "rdfs:comment": "An ORG Membership — a role-and-time-aware participation of an Agent in an Organization.",
  "owl:sameAs": "http://www.w3.org/ns/org#Membership",
  "rdfs:seeAlso": [
    "urn:solid:memberOf",
    "urn:solid:Organization",
    "http://www.w3.org/ns/org#role",
    "http://www.w3.org/ns/org#memberDuring"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Use when membership has structure — a role, or start/end dates via `org:memberDuring` (a time:Interval) — that doesn't fit into a flat `urn:solid:memberOf` triple. Carries `org:member` (the Agent), `org:organization` (the Organization), and `org:role`. For simple membership, the flat `urn:solid:memberOf` predicate is enough.",
  "examples": [
    {
      "title": "A role-aware membership",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/memberships/alice-acme-2026",
        "@type": "urn:solid:Membership",
        "http://www.w3.org/ns/org#member": { "@id": "https://example.org/alice#me" },
        "http://www.w3.org/ns/org#organization": { "@id": "https://example.org/orgs/acme-ltd" },
        "http://www.w3.org/ns/org#role": { "@id": "https://example.org/roles/senior-engineer" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/org#Membership"
    ],
    "curatedBy": "claude-curate-next"
  },
