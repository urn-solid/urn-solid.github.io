{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Update",
  "@type": "rdfs:Class",
  "rdfs:label": "Update",
  "rdfs:comment": "An activity in which the actor has updated the object.",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#Update",
  "rdfs:seeAlso": [
    "https://schema.org/UpdateAction",
    "urn:solid:Create"
  ],
  "notToBeConfusedWith": [
    "urn:solid:Create"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Subclass of `urn:solid:Activity`. The wire-level signal that an actor edited an existing object — receivers should replace their cached copy with the updated payload in `as:object`. Pair with `as:published` for when the edit happened.",
  "examples": [
    {
      "title": "Alice updates a note",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/activities/910",
        "@type": "urn:solid:Update",
        "https://www.w3.org/ns/activitystreams#actor": { "@id": "https://example.org/alice#me" },
        "https://www.w3.org/ns/activitystreams#object": {
          "@id": "https://example.org/notes/abc",
          "https://www.w3.org/ns/activitystreams#content": "Hello, fediverse! (edited)"
        }
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://www.w3.org/ns/activitystreams#Update"
    ],
