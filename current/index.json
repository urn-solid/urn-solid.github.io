{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:current",
  "@type": "rdf:Property",
  "rdfs:label": "current",
  "rdfs:comment": "The page of an ActivityStreams Collection that contains the most recent items — clients seeking \"what's new\" start here rather than at `first`.",
  "owl:sameAs": "http://www.w3.org/ns/activitystreams#current",
  "rdfs:seeAlso": [
    "urn:solid:Collection",
    "urn:solid:first",
    "urn:solid:last",
    "urn:solid:next",
    "urn:solid:prev"
  ],
  "rdfs:domain": "urn:solid:Collection",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Distinct from `as:first` and `as:last`: `current` is the *live edge* of a Collection that grows over time. For an inbox or a follower list, `current` is where new arrivals appear; older items live further along the chain. Servers without a meaningful \"current\" notion may omit it.",
  "examples": [
    {
      "title": "Inbox with a current page pointer",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://alice.example.org/inbox",
        "@type": "http://www.w3.org/ns/activitystreams#OrderedCollection",
        "urn:solid:totalItems": 184,
        "urn:solid:first": { "@id": "https://alice.example.org/inbox?page=oldest" },
        "urn:solid:current": { "@id": "https://alice.example.org/inbox?page=latest" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/activitystreams#current"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  }
}
