{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Video",
  "@type": "rdfs:Class",
  "rdfs:label": "Video",
  "rdfs:comment": "A video resource — used in ActivityPub for video attachments and stand-alone video posts.",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#Video",
  "rdfs:seeAlso": [
    "urn:solid:VideoObject"
  ],
  "notToBeConfusedWith": [
    "urn:solid:VideoObject"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "ActivityStreams video type — used by PeerTube and similar federated video platforms. Distinct from `urn:solid:VideoObject` (schema.org) which carries richer SEO-friendly metadata. Pick by data flavor.",
  "examples": [
    {
      "title": "Note with a video attachment",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/notes/clip-1",
        "@type": "urn:solid:Note",
        "urn:solid:attachment": {
          "@type": "urn:solid:Video",
          "https://www.w3.org/ns/activitystreams#url": { "@id": "https://example.org/videos/clip.mp4" },
          "urn:solid:mediaType": "video/mp4",
          "urn:solid:duration": "PT45S"
        }
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://www.w3.org/ns/activitystreams#Video"
    ],
    "curatedBy": "claude-curate-next"
  },
