{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:trustedApp",
  "@type": "rdf:Property",
  "rdfs:label": "trustedApp",
  "rdfs:comment": "On a Solid pod owner's profile, an application origin granted broad trust — typically permitted to read or write across the pod without per-resource ACL grants.",
  "owl:sameAs": "http://www.w3.org/ns/auth/acl#trustedApp",
  "rdfs:seeAlso": [
    "urn:solid:origin",
    "urn:solid:mode",
    "urn:solid:Authorization"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "A pre-WAC-AC pattern, still widely used: each `trustedApp` value carries `acl:origin` (the app's URL origin) and `acl:mode` (the modes granted). Solid CSS, NSS, and others honour this for app-level authorisation. Newer specs (ACP) supersede it but legacy pods still depend on it.",
  "examples": [
    {
      "title": "Profile granting an app Read+Write trust",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://alice.example.org/profile/card#me",
        "@type": "urn:solid:Person",
        "urn:solid:trustedApp": {
          "urn:solid:origin": { "@id": "https://app.example.org" },
          "urn:solid:mode": [
            { "@id": "http://www.w3.org/ns/auth/acl#Read" },
            { "@id": "http://www.w3.org/ns/auth/acl#Write" }
          ]
        }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/auth/acl#trustedApp"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  }
}
