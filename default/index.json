{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:default",
  "@type": "rdf:Property",
  "rdfs:label": "default",
  "rdfs:comment": "The container whose descendant resources (lacking their own ACL) inherit this Authorization; the WAC inheritance mechanism.",
  "owl:sameAs": "http://www.w3.org/ns/auth/acl#default",
  "rdfs:seeAlso": [
    "urn:solid:Authorization",
    "urn:solid:accessTo",
    "urn:solid:Container",
    "urn:solid:mode"
  ],
  "rdfs:domain": "urn:solid:Authorization",
  "notToBeConfusedWith": [
    "urn:solid:accessTo"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Value is a Container URI. The Authorization then applies — by inheritance — to every resource inside that Container (recursively) which does not have its own ACL. Replaces the older `acl:defaultForNew`. Without `default`, an Authorization on a Container governs only the Container resource itself, not its members.",
  "examples": [
    {
      "title": "Authorization that grants Read by default to a subtree",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/photos/.acl#public-default",
        "@type": "urn:solid:Authorization",
        "http://www.w3.org/ns/auth/acl#agentClass": { "@id": "http://xmlns.com/foaf/0.1/Agent" },
        "http://www.w3.org/ns/auth/acl#default": { "@id": "https://alice.example.org/photos/" },
        "urn:solid:mode": { "@id": "http://www.w3.org/ns/auth/acl#Read" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/auth/acl#default"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    },
    {
      "event": "updated",
      "at": "2026-10-29T00:00:00Z",
      "by": "urn-solid-review",
      "note": "Definition: object is the container whose descendants inherit the Authorization."
    }
  ],
