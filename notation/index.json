{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:notation",
  "@type": "rdf:Property",
  "rdfs:label": "notation",
  "rdfs:comment": "A symbolic identifier for a SKOS Concept within a particular notation system (Dewey numbers, ISBN-style codes, taxonomy IDs).",
  "owl:sameAs": "http://www.w3.org/2004/02/skos/core#notation",
  "rdfs:seeAlso": [
    "urn:solid:Concept",
    "urn:solid:prefLabel",
    "urn:solid:inScheme"
  ],
  "rdfs:domain": "urn:solid:Concept",
  "notToBeConfusedWith": [
    "urn:solid:prefLabel",
    "urn:solid:altLabel"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Unlike `skos:prefLabel` (a human-readable string in a natural language), `skos:notation` is a typed literal whose datatype identifies the notation system — e.g. a Dewey Decimal code typed as `<http://example.org/dewey>` is distinct from a UDC code with the same digits. A Concept may carry multiple notations from different schemes.",
  "examples": [
    {
      "title": "Concept with a notation",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/scheme/dewey#510",
        "@type": "urn:solid:Concept",
        "urn:solid:prefLabel": "Mathematics",
        "urn:solid:notation": { "@value": "510", "@type": "https://example.org/dewey-code" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2004/02/skos/core#notation"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  }
}
