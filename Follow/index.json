{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Follow",
  "@type": "rdfs:Class",
  "rdfs:label": "Follow",
  "rdfs:comment": "An indication that the actor wants to follow the object — typically another Actor.",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#Follow",
  "rdfs:seeAlso": [
    "https://schema.org/FollowAction",
    "urn:solid:knows"
  ],
  "notToBeConfusedWith": [
    "urn:solid:knows"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Subclass of `urn:solid:Activity`. The ActivityPub follow request — typically responded to with `as:Accept` or `as:Reject` by the followee. Use `urn:solid:knows` for non-directed acquaintance (FOAF tradition). To unfollow, send an `as:Undo` of the original Follow.",
  "examples": [
    {
      "title": "Alice follows Bob",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/follows/456",
        "@type": "urn:solid:Follow",
        "https://www.w3.org/ns/activitystreams#actor": { "@id": "https://example.org/alice#me" },
        "https://www.w3.org/ns/activitystreams#object": { "@id": "https://example.org/bob#me" }
      }
    }
  ],
