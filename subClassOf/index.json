{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:subClassOf",
  "@type": "rdf:Property",
  "rdfs:label": "subClassOf",
  "rdfs:comment": "Asserts that one class is a subclass of another — instances of the subclass are also instances of the superclass.",
  "owl:sameAs": "http://www.w3.org/2000/01/rdf-schema#subClassOf",
  "rdfs:seeAlso": [
    "urn:solid:Class",
    "urn:solid:subPropertyOf",
    "urn:solid:type"
  ],
  "rdfs:domain": "urn:solid:Class",
  "rdfs:range": "urn:solid:Class",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Transitive: if A is a subclass of B and B of C, then A is a subclass of C. Reasoners use this to infer that a `urn:solid:Person` is also a `urn:solid:Agent`. A class may be a subclass of multiple parents (multiple inheritance is permitted in RDFS).",
  "examples": [
    {
      "title": "Person is a subclass of Agent",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "urn:solid:Person",
        "@type": "urn:solid:Class",
        "urn:solid:subClassOf": { "@id": "urn:solid:Agent" }
      }
    }
  ],
  "provenance": {
