  "@id": "urn:solid:VerifiablePresentation",
  "@type": "rdfs:Class",
  "rdfs:label": "VerifiablePresentation",
  "rdfs:comment": "A W3C Verifiable Presentation — a holder-signed bundle of one or more VerifiableCredentials, prepared for a specific verifier.",
  "owl:sameAs": "https://www.w3.org/2018/credentials#VerifiablePresentation",
  "rdfs:seeAlso": [
    "urn:solid:VerifiableCredential",
    "urn:solid:holder",
    "urn:solid:proof"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Wraps Credentials so the holder can prove they currently possess them, often binding the bundle to a specific challenge (nonce + verifier identity) for replay protection. The holder's `proof` is added on top of the issuer's `proof` on each contained Credential — both must verify.",
  "examples": [
    {
      "title": "A presentation containing one credential",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@type": "urn:solid:VerifiablePresentation",
        "urn:solid:holder": { "@id": "https://alice.example.org/profile/card#me" },
        "https://www.w3.org/2018/credentials#verifiableCredential": { "@id": "https://example.org/credentials/3732" }
      }
    }
  ],
