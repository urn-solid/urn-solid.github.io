{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:cardinality",
  "@type": "rdf:Property",
  "rdfs:label": "cardinality",
  "rdfs:comment": "On an OWL Restriction, asserts that the constrained property must have *exactly* this many values.",
  "owl:sameAs": "http://www.w3.org/2002/07/owl#cardinality",
  "rdfs:seeAlso": [
    "urn:solid:Restriction",
    "urn:solid:minCardinality",
    "urn:solid:maxCardinality",
    "urn:solid:onProperty"
  ],
  "rdfs:domain": "urn:solid:Restriction",
  "rdfs:range": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger",
  "notToBeConfusedWith": [
    "urn:solid:minCardinality",
    "urn:solid:maxCardinality"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Equivalent to `minCardinality` and `maxCardinality` both set to the same value. Use when the count is fixed (every Triangle has exactly 3 sides). For a range of counts, combine `minCardinality` and `maxCardinality`.",
  "examples": [
    {
      "title": "Class requiring exactly one issuer",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@type": "urn:solid:Restriction",
        "urn:solid:onProperty": { "@id": "urn:solid:issuer" },
        "urn:solid:cardinality": { "@value": "1", "@type": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger" }
      }
    }
  ],
