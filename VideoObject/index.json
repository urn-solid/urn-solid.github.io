{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:VideoObject",
  "@type": "rdfs:Class",
  "rdfs:label": "VideoObject",
  "rdfs:comment": "A video file with structured metadata — duration, resolution, encoding, thumbnail.",
  "owl:sameAs": "https://schema.org/VideoObject",
  "rdfs:seeAlso": [
    "urn:solid:Video",
    "urn:solid:ImageObject",
    "urn:solid:AudioObject"
  ],
  "notToBeConfusedWith": [
    "urn:solid:Video",
    "urn:solid:Movie"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Schema.org's video type, sibling to `urn:solid:ImageObject`. Carries `schema:contentUrl`, `schema:duration`, `schema:width`/`schema:height`, `schema:thumbnailUrl`, `schema:embedUrl`. For ActivityPub-style social video posts, prefer `urn:solid:Video` (as:Video).",
  "examples": [
    {
      "title": "A short video",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/videos/intro.mp4",
        "@type": "urn:solid:VideoObject",
        "https://schema.org/contentUrl": { "@id": "https://example.org/videos/intro.mp4" },
        "https://schema.org/duration": "PT2M30S",
        "https://schema.org/encodingFormat": "video/mp4"
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://schema.org/VideoObject"
    ],
    "curatedBy": "claude-curate-next"
  },
