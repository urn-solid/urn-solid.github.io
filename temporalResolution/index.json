{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:temporalResolution",
  "@type": "rdf:Property",
  "rdfs:label": "temporalResolution",
  "rdfs:comment": "The minimum time between samples in a DCAT Dataset or Distribution — the granularity of the time axis.",
  "owl:sameAs": "http://www.w3.org/ns/dcat#temporalResolution",
  "rdfs:seeAlso": [
    "urn:solid:Dataset",
    "urn:solid:Distribution",
    "urn:solid:temporal"
  ],
  "rdfs:domain": "urn:solid:Dataset",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Encoded as an `xsd:duration` (`PT1H` = hourly samples, `P1D` = daily, `PT15M` = 15-minute). Crucial when the same dataset is published at multiple cadences — clients pick the right Distribution based on the resolution they need, not just the format.",
  "examples": [
    {
      "title": "A dataset with hourly temporal resolution",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://data.example.org/sensors/temperature",
        "@type": "urn:solid:Dataset",
        "urn:solid:temporalResolution": { "@value": "PT1H", "@type": "http://www.w3.org/2001/XMLSchema#duration" }
      }
    }
  ],
