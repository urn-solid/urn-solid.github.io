{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:requires",
  "@type": "rdf:Property",
  "rdfs:label": "requires",
  "rdfs:comment": "A related resource that is required by the described resource to support its function or coherence.",
  "owl:sameAs": "http://purl.org/dc/terms/requires",
  "rdfs:seeAlso": [
    "urn:solid:isRequiredBy",
    "https://schema.org/softwareRequirements"
  ],
  "notToBeConfusedWith": [
    "urn:solid:isRequiredBy"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Use for hard dependencies — software that needs another library, a document that requires its referenced datasets, an API spec requiring an auth scheme. Repeat for multiple dependencies. The inverse is `urn:solid:isRequiredBy`.",
  "examples": [
    {
      "title": "Document requiring another resource",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://urn-solid.com/Person/index.html",
        "@type": "urn:solid:Document",
        "urn:solid:requires": {
          "@id": "https://urn-solid.com/render.js"
        }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://purl.org/dc/terms/requires"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-18T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    },
    {
      "event": "updated",
      "at": "2026-10-29T00:00:00Z",
      "by": "urn-solid-review",
      "note": "seeAlso uses urn:solid:isRequiredBy and schema:softwareRequirements (replaces superseded schema:requirements); added inverse to notToBeConfusedWith."
    }
  ],
  "see_also": {
