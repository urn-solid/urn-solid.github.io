    "http://www.w3.org/2006/vcard/ns#country-name"
  ],
  "status": "stable",
  "added": "2026-04-25",
  "notes": "Class form for postal addresses. Used as the value of `urn:solid:hasAddress`. The address parts (street-address, locality, region, postal-code, country-name) are vCard-style flat literals on the Address instance, not nested.",
  "examples": [
    {
      "title": "Person with a postal address",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/alice#me",
        "@type": "urn:solid:Person",
        "urn:solid:hasAddress": {
          "@type": "urn:solid:Address",
          "http://www.w3.org/2006/vcard/ns#street-address": "10 Downing Street",
          "http://www.w3.org/2006/vcard/ns#locality": "London",
          "http://www.w3.org/2006/vcard/ns#postal-code": "SW1A 2AA",
          "http://www.w3.org/2006/vcard/ns#country-name": "United Kingdom"
        }
      }
    }
  ],
