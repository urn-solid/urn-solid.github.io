{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Address",
  "@type": "rdfs:Class",
  "rdfs:label": "Address",
  "rdfs:comment": "A postal address — the value class for `urn:solid:hasAddress` (street, locality, region, postal code, country).",
  "owl:sameAs": "http://www.w3.org/2006/vcard/ns#Address",
