  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "DCAT prefers repeated singular `dcat:keyword` literals (one per language tag) over schema.org's comma-separated `urn:solid:keywords` string. For controlled-vocabulary topical metadata, prefer `dcat:theme` with SKOS Concepts.",
  "examples": [
    {
      "title": "Dataset with keywords",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://example.org/datasets/wonderland-2026",
        "@type": "urn:solid:Dataset",
        "urn:solid:keyword": ["climate", "wonderland", "annual report"]
      }
    }
  ],
