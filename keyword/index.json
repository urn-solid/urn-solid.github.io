{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:keyword",
  "@type": "rdf:Property",
  "rdfs:label": "keyword",
  "rdfs:comment": "A free-text keyword or tag describing a DCAT catalogued resource (Dataset, DataService, or Catalog); repeat for multiple keywords.",
  "owl:sameAs": "http://www.w3.org/ns/dcat#keyword",
  "rdfs:seeAlso": [
    "urn:solid:keywords",
    "urn:solid:subject"
  ],
  "notToBeConfusedWith": [
    "urn:solid:keywords",
    "urn:solid:categories",
    "urn:solid:theme"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "DCAT uses one `dcat:keyword` literal per keyword (optionally language-tagged), not a comma-separated string like `urn:solid:keywords`. For controlled-vocabulary topical metadata, prefer `dcat:theme` with SKOS Concepts.",
  "examples": [
    {
      "title": "Dataset with keywords",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/datasets/wonderland-2026",
        "@type": "urn:solid:Dataset",
        "urn:solid:keyword": [
          "climate",
          "wonderland",
          "annual report"
        ]
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/dcat#keyword"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    },
    {
      "event": "updated",
      "at": "2026-10-29T00:00:00Z",
      "by": "urn-solid-review",
      "note": "Fixed 'one per language tag' to one literal per keyword; comment covers DataService too."
    },
    {
      "event": "updated",
      "at": "2026-10-29T00:00:00Z",
      "by": "urn-solid-review",
      "note": "Added reciprocal notToBeConfusedWith links."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  }
}
