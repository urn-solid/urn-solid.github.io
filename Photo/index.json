{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Photo",
  "@type": "rdfs:Class",
  "rdfs:label": "Photo",
  "rdfs:comment": "A vCard Photo resource — a photographic image associated with a vCard.",
  "owl:sameAs": "http://www.w3.org/2006/vcard/ns#Photo",
  "rdfs:seeAlso": [
    "urn:solid:Image",
    "urn:solid:ImageObject",
    "urn:solid:hasPhoto"
  ],
  "notToBeConfusedWith": [
    "urn:solid:Image",
    "urn:solid:ImageObject"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Use as @type for the value of `urn:solid:hasPhoto` when modelling the photo as a structured resource (with format, source, etc.) rather than a bare URL. For non-vCard image resources, prefer `urn:solid:Image` (FOAF) or `urn:solid:ImageObject` (schema.org).",
  "examples": [
    {
      "title": "vCard with a Photo resource",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/cards/alice",
        "@type": "urn:solid:VCard",
        "urn:solid:hasPhoto": {
          "@type": "urn:solid:Photo",
          "https://www.w3.org/ns/activitystreams#url": { "@id": "https://example.org/alice/photo.jpg" }
        }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2006/vcard/ns#Photo"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  }
}
