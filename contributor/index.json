{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:contributor",
  "@type": "rdf:Property",
  "rdfs:label": "contributor",
  "rdfs:comment": "An entity responsible for making contributions to the resource — secondary to the principal creator.",
  "owl:sameAs": "http://purl.org/dc/terms/contributor",
  "rdfs:seeAlso": [
    "https://schema.org/contributor"
  ],
  "rdfs:range": "urn:solid:Agent",
  "notToBeConfusedWith": [
    "urn:solid:creator",
    "urn:solid:publisher",
    "urn:solid:author",
    "urn:solid:editor"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Use for editors, reviewers, translators, co-authors of secondary weight. Repeat for multiple contributors. The principal author goes under `urn:solid:creator` instead. For a role-aware model, use `prov:qualifiedAttribution` → a `prov:Attribution` with `prov:agent` and `prov:hadRole`.",
  "examples": [
    {
      "title": "Document with creator and contributor",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/posts/hello",
        "@type": "urn:solid:Document",
        "urn:solid:creator": { "@id": "https://example.org/alice#me" },
        "urn:solid:contributor": { "@id": "https://example.org/bob#me" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://purl.org/dc/terms/contributor"
    ],
