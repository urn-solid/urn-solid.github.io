    "urn:solid:hasSource"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Use to record the upstream origin of derived works (translations, adaptations, summaries, scraped data). For PROV-grade derivation chains with role and timing, prefer `urn:solid:wasDerivedFrom`. Repeat to list multiple sources.",
  "examples": [
    {
      "title": "Translation pointing at its source",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/posts/hello-de",
        "@type": "urn:solid:Document",
        "urn:solid:language": "de",
        "urn:solid:source": { "@id": "https://example.org/posts/hello" }
      }
    }
  ],
