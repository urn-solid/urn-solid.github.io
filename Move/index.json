{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Move",
  "@type": "rdfs:Class",
  "rdfs:label": "Move",
  "rdfs:comment": "An activity in which the actor moves the object from one location (origin) to another (target).",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#Move",
  "rdfs:seeAlso": [
    "urn:solid:Add",
    "urn:solid:Remove"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Subclass of `urn:solid:Activity`. Combines `Add` + `Remove` semantics: `as:object` is what's being moved, `as:origin` names the source location, `as:target` names the destination. Common use in ActivityPub is account migration (moving an actor from one server to another).",
  "examples": [
    {
      "title": "Account migration",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://old.example.org/activities/move-1",
        "@type": "urn:solid:Move",
        "https://www.w3.org/ns/activitystreams#actor": { "@id": "https://old.example.org/alice#me" },
        "https://www.w3.org/ns/activitystreams#object": { "@id": "https://old.example.org/alice#me" },
        "https://www.w3.org/ns/activitystreams#target": { "@id": "https://new.example.org/alice#me" }
      }
    }
  ],
