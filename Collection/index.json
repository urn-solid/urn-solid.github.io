{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Collection",
  "@type": "rdfs:Class",
  "rdfs:label": "Collection",
  "rdfs:comment": "An ActivityStreams set of Object or Link instances, enumerated via as:items or paged via as:first/as:next. Members carry no guaranteed order — use the OrderedCollection subclass when order matters.",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#Collection",
  "rdfs:seeAlso": [
    "urn:solid:OrderedCollection",
    "http://www.w3.org/ns/ldp#Container",
    "http://www.w3.org/ns/prov#Collection"
  ],
  "notToBeConfusedWith": [
    "urn:solid:OrderedCollection",
    "urn:solid:Container",
    "urn:solid:Catalog",
    "urn:solid:ConceptScheme",
    "urn:solid:EmptyCollection"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Subclass of `urn:solid:Object`. Use `as:items` (or paginate via `as:first`/`as:next`) to enumerate members. For ordered membership (timelines, replies, outboxes), use `as:OrderedCollection`. For Linked Data Platform containers with HTTP-level membership semantics, use `ldp:Container`.",
  "examples": [
    {
      "title": "A collection with two items",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/collections/favorites",
        "@type": "urn:solid:Collection",
        "https://www.w3.org/ns/activitystreams#totalItems": 2,
        "https://www.w3.org/ns/activitystreams#items": [
          { "@id": "https://example.org/notes/a" },
          { "@id": "https://example.org/notes/b" }
        ]
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://www.w3.org/ns/activitystreams#Collection"
    ],
    "curatedBy": "claude-curate-next"
  },
