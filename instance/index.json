{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:instance",
  "@type": "rdf:Property",
  "rdfs:label": "instance",
  "rdfs:comment": "A single resource that's an instance of the class declared by the TypeRegistration.",
  "owl:sameAs": "http://www.w3.org/ns/solid/terms#instance",
  "rdfs:seeAlso": [
    "http://www.w3.org/ns/solid/terms#instanceContainer",
    "urn:solid:TypeRegistration"
  ],
  "rdfs:domain": "urn:solid:TypeRegistration",
  "notToBeConfusedWith": [],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Use when the user has exactly one instance — typically a settings document or singleton. For collections of instances under a directory, use `solid:instanceContainer` instead. A single TypeRegistration may carry multiple `solid:instance` values.",
  "examples": [
    {
      "title": "Registration for a single preferences file",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/settings/privateTypeIndex.ttl#prefs",
        "@type": "urn:solid:TypeRegistration",
        "urn:solid:forClass": { "@id": "http://www.w3.org/ns/pim/space#ConfigurationFile" },
        "urn:solid:instance": { "@id": "https://alice.example.org/settings/prefs.ttl" }
      }
    }
  ],
