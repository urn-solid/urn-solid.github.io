{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:img",
  "@type": "rdf:Property",
  "rdfs:label": "img",
  "rdfs:comment": "An image that represents the person — typically a headshot or portrait.",
  "owl:sameAs": "http://xmlns.com/foaf/0.1/img",
  "rdfs:seeAlso": [
    "urn:solid:depiction",
    "http://www.w3.org/2006/vcard/ns#hasPhoto",
    "https://schema.org/image"
  ],
  "rdfs:domain": "urn:solid:Person",
  "rdfs:range": "urn:solid:Image",
  "notToBeConfusedWith": [
    "urn:solid:depiction",
    "urn:solid:image",
    "urn:solid:hasPhoto",
    "urn:solid:icon"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Sub-property of `urn:solid:depiction`, for an image that represents a person (e.g. a homepage portrait/avatar). Use depiction for images of any thing, or images where the person merely appears.",
  "examples": [
    {
      "title": "Person with a portrait",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/alice#me",
        "@type": "urn:solid:Person",
        "urn:solid:img": { "@id": "https://example.org/alice/portrait.jpg" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://xmlns.com/foaf/0.1/img"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
