  "@id": "urn:solid:logoutEndpoint",
  "@type": "rdf:Property",
  "rdfs:label": "logoutEndpoint",
  "rdfs:comment": "The logout endpoint URL for a Solid OIDC provider.",
  "owl:sameAs": "http://www.w3.org/ns/solid/terms#logoutEndpoint",
  "rdfs:seeAlso": [
    "urn:solid:loginEndpoint",
    "urn:solid:oidcIssuer"
  ],
  "notToBeConfusedWith": [
    "urn:solid:loginEndpoint"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Counterpart to `urn:solid:loginEndpoint`. Advertised by a Solid OIDC provider as the URL where users can sign out. Most modern Solid OIDC implementations expose this via OIDC discovery (`/.well-known/openid-configuration`'s `end_session_endpoint`) rather than via this predicate.",
  "examples": [
    {
      "title": "OIDC issuer with login and logout endpoints",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://login.example.org/",
        "urn:solid:loginEndpoint": { "@id": "https://login.example.org/login" },
        "urn:solid:logoutEndpoint": { "@id": "https://login.example.org/logout" }
      }
    }
  ],
