{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:agent",
  "@type": "rdf:Property",
  "rdfs:label": "agent",
  "rdfs:comment": "In a Web Access Control Authorization, a specific agent (by WebID) that is granted the listed access modes.",
  "owl:sameAs": "http://www.w3.org/ns/auth/acl#agent",
  "rdfs:seeAlso": [
    "urn:solid:Authorization",
    "urn:solid:agentClass",
    "urn:solid:agentGroup",
    "urn:solid:accessTo"
  ],
  "rdfs:domain": "urn:solid:Authorization",
  "rdfs:range": "urn:solid:Agent",
  "notToBeConfusedWith": [
    "urn:solid:agentClass",
    "urn:solid:agentGroup",
    "urn:solid:actor"
  ],
  "status": "stable",
  "added": "2026-10-29",
  "notes": "One of the three WAC ways to say who an Authorization applies to: `agent` (an individual WebID), `agentGroup` (members of a vcard:Group), `agentClass` (a class such as foaf:Agent for everyone, or acl:AuthenticatedAgent). Not related to the PROV notion of agent.",
  "examples": [
    {
      "title": "Grant Bob read access",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/doc.acl#bob",
        "@type": "urn:solid:Authorization",
        "urn:solid:agent": {
          "@id": "https://bob.example.org/profile/card#me"
        },
        "urn:solid:accessTo": {
          "@id": "https://alice.example.org/doc"
        },
        "urn:solid:mode": {
          "@id": "urn:solid:Read"
        }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/auth/acl#agent"
    ],
    "curatedBy": "urn-solid-review"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-10-29T00:00:00Z",
      "by": "urn-solid-review",
      "note": "Added during the registry-wide review: referenced by existing terms and examples but previously unregistered."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  }
}
