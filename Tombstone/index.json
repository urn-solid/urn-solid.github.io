{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:Tombstone",
  "@type": "rdfs:Class",
  "rdfs:label": "Tombstone",
  "rdfs:comment": "A marker for an Object that previously existed but has been deleted.",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#Tombstone",
  "rdfs:seeAlso": [
    "urn:solid:Delete"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Subclass of `urn:solid:Object`. After receiving an `as:Delete`, ActivityPub servers replace the deleted object with a Tombstone — preserving the IRI so inbound references don't break, but signalling the resource is gone. Carries `as:formerType` (what it used to be) and `as:deleted` (when).",
  "examples": [
    {
      "title": "Deleted note as a Tombstone",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://example.org/notes/abc",
        "@type": "urn:solid:Tombstone",
        "https://www.w3.org/ns/activitystreams#formerType": { "@id": "https://www.w3.org/ns/activitystreams#Note" },
        "https://www.w3.org/ns/activitystreams#deleted": "2026-04-18T12:00:00Z"
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://www.w3.org/ns/activitystreams#Tombstone"
    ],
