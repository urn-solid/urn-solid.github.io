{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:AddressBook",
  "@type": "rdfs:Class",
  "rdfs:label": "AddressBook",
  "rdfs:comment": "A collection of contacts — a personal or shared address book.",
  "owl:sameAs": "http://www.w3.org/2006/vcard/ns#AddressBook",
  "rdfs:seeAlso": [
    "urn:solid:hasMember",
    "urn:solid:Person",
    "http://xmlns.com/foaf/0.1/Group"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "The vcard AddressBook class — used by SolidOS and inrupt apps as the canonical type for an address book resource. Pair with `urn:solid:hasMember` for the entries. Each member is typically a `urn:solid:Person`.",
  "examples": [
    {
      "title": "An address book with two members",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/contacts/",
        "@type": "urn:solid:AddressBook",
        "urn:solid:title": "My Contacts",
        "urn:solid:hasMember": [
          { "@id": "https://bob.example.org/profile/card#me" },
          { "@id": "https://carol.example.org/#me" }
        ]
      }
    }
  ],
