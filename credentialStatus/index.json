{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:credentialStatus",
  "@type": "rdf:Property",
  "rdfs:label": "credentialStatus",
  "rdfs:comment": "A reference to a status mechanism for a VerifiableCredential — e.g. a revocation list — that verifiers consult to check whether the credential is still active.",
  "owl:sameAs": "https://www.w3.org/2018/credentials#credentialStatus",
  "rdfs:seeAlso": [
    "urn:solid:VerifiableCredential",
    "urn:solid:expirationDate"
  ],
  "rdfs:domain": "urn:solid:VerifiableCredential",
  "notToBeConfusedWith": [
    "urn:solid:expirationDate"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Distinct from expiration (a static date in the credential). Status is dynamic — the credential is signed once but can be revoked any time after. Common types: `RevocationList2020Status`, `StatusList2021Entry`. Verifiers fetch the referenced status document and check the credential's bit/index.",
  "examples": [
    {
      "title": "Credential with a revocation entry",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://example.org/credentials/3732",
        "@type": "urn:solid:VerifiableCredential",
        "urn:solid:credentialStatus": {
          "@id": "https://example.edu/status/24#94567",
          "@type": "https://www.w3.org/2018/credentials#StatusList2021Entry"
        }
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://www.w3.org/2018/credentials#credentialStatus"
    ],
    "curatedBy": "claude-curate-next"
  },
