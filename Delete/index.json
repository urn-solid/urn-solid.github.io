{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Delete",
  "@type": "rdfs:Class",
  "rdfs:label": "Delete",
  "rdfs:comment": "An activity in which the actor has deleted the object.",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#Delete",
  "rdfs:seeAlso": [
    "https://schema.org/DeleteAction",
    "urn:solid:Tombstone"
  ],
  "notToBeConfusedWith": [
    "urn:solid:Remove",
    "urn:solid:Undo"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Subclass of `urn:solid:Activity`. The wire-level signal that an object has been removed. The origin server MAY replace the object with an `as:Tombstone` so its IRI keeps resolving; receiving servers remove or hide their copy. Distinct from `Remove`, which only ends membership in a target collection.",
  "examples": [
    {
      "title": "Alice deletes a note",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/activities/del-1",
        "@type": "urn:solid:Delete",
        "https://www.w3.org/ns/activitystreams#actor": { "@id": "https://example.org/alice#me" },
        "https://www.w3.org/ns/activitystreams#object": { "@id": "https://example.org/notes/abc" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://www.w3.org/ns/activitystreams#Delete"
    ],
    "curatedBy": "claude-curate-next"
