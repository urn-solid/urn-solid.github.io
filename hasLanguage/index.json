{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:hasLanguage",
  "@type": "rdf:Property",
  "rdfs:label": "hasLanguage",
  "rdfs:comment": "A language the subject communicates in — a language IRI or a node carrying a BCP 47 tag.",
  "owl:sameAs": "http://www.w3.org/2006/vcard/ns#hasLanguage",
  "rdfs:seeAlso": [
    "urn:solid:knowsLanguage",
    "urn:solid:language"
  ],
  "notToBeConfusedWith": [
    "urn:solid:knowsLanguage",
    "urn:solid:language",
    "urn:solid:inLanguage"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "vCard's communicates-in-language predicate. Upstream it is an object property; the BCP 47 tag goes on a node via vcard:value (or use a language IRI such as http://id.loc.gov/vocabulary/iso639-1/en). Functionally similar to schema's `urn:solid:knowsLanguage`; pick whichever matches your data flavor. Distinct from `urn:solid:language` (the language a *resource* is in).",
  "examples": [
    {
      "title": "vCard with preferred languages",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/cards/alice",
        "@type": "urn:solid:VCard",
        "urn:solid:hasLanguage": [
          { "@id": "http://id.loc.gov/vocabulary/iso639-1/en" },
          { "@id": "http://id.loc.gov/vocabulary/iso639-1/fr" }
        ]
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2006/vcard/ns#hasLanguage"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-18T00:00:00Z",
