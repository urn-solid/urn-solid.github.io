{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:Notification",
  "@type": "rdfs:Class",
  "rdfs:label": "Notification",
  "rdfs:comment": "A Linked Data Notification — a message POSTed to an inbox to inform the receiver about something.",
  "owl:sameAs": "http://www.w3.org/ns/solid/terms#Notification",
  "rdfs:seeAlso": [
    "urn:solid:inbox",
    "urn:solid:Activity"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "From Linked Data Notifications (LDN) and Solid notifications. POSTed to a `urn:solid:inbox` container. The payload is RDF; common shapes use ActivityStreams `as:Activity` so the same primitive carries both \"a thing happened\" and \"please notify someone\".",
  "examples": [
    {
      "title": "A simple notification",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://alice.example.org/inbox/notif-1",
        "@type": "urn:solid:Notification",
        "https://www.w3.org/ns/activitystreams#actor": { "@id": "https://example.org/bob#me" },
        "urn:solid:content": "Bob wants to share a file with you."
      }
    }
  ],
