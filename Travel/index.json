{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Travel",
  "@type": "rdfs:Class",
  "rdfs:label": "Travel",
  "rdfs:comment": "An ActivityStreams Activity indicating that the actor is travelling between two locations — the origin is the `origin`, the destination is the `target`.",
  "owl:sameAs": "http://www.w3.org/ns/activitystreams#Travel",
  "rdfs:seeAlso": [
    "urn:solid:Move",
    "urn:solid:Arrive",
    "urn:solid:Place",
    "urn:solid:target",
    "urn:solid:origin"
  ],
  "notToBeConfusedWith": [
    "urn:solid:Move",
    "urn:solid:Arrive"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "The IntransitiveActivity for ongoing journey — distinct from `as:Move` (which moves an *object*) and `as:Arrive` (which marks completion). Use Travel for in-progress trips; pair with `Arrive` once the destination is reached.",
  "examples": [
    {
      "title": "Actor travelling from London to Paris",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/activities/trip-1",
        "@type": "urn:solid:Travel",
        "urn:solid:actor": { "@id": "https://alice.example.org/profile/card#me" },
        "urn:solid:origin": { "@id": "https://example.org/places/london" },
        "urn:solid:target": { "@id": "https://example.org/places/paris" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/activitystreams#Travel"
    ],
