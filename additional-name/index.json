{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:additional-name",
  "@type": "rdf:Property",
  "rdfs:label": "additional-name",
  "rdfs:comment": "An additional or middle name of the person.",
  "owl:sameAs": "http://www.w3.org/2006/vcard/ns#additional-name",
  "rdfs:seeAlso": [
    "urn:solid:given-name",
    "urn:solid:family-name",
    "https://schema.org/additionalName"
  ],
  "rdfs:range": "http://www.w3.org/2001/XMLSchema#string",
  "status": "stable",
  "added": "2026-04-18",
  "notes": "vCard's middle-name field — separate from `urn:solid:given-name` and `urn:solid:family-name`. Repeat for multiple middle names. Note the hyphen in the source name is preserved. Schema.org equivalent is `schema:additionalName`.",
  "examples": [
    {
      "title": "Person with first, middle, and last names",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/cards/alice",
        "@type": "urn:solid:VCard",
        "urn:solid:given-name": "Alice",
        "urn:solid:additional-name": "Pleasance",
        "urn:solid:family-name": "Liddell"
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2006/vcard/ns#additional-name"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-18T00:00:00Z",
