{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:href",
  "@type": "rdf:Property",
  "rdfs:label": "href",
  "rdfs:comment": "The target URL of an ActivityStreams Link — the resource the Link points at.",
  "owl:sameAs": "http://www.w3.org/ns/activitystreams#href",
  "rdfs:seeAlso": [
    "urn:solid:Link",
    "urn:solid:Mention",
    "urn:solid:Hashtag",
    "urn:solid:rel"
  ],
  "rdfs:domain": "urn:solid:Link",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "The defining property of a Link — without `href` a Link has no destination. Distinct from `@id` (the Link object's own identifier, often omitted): `@id` identifies the Link, `href` identifies what it links to. Used heavily by `Mention` and `Hashtag` to point at the mentioned actor or topic feed.",
  "examples": [
    {
      "title": "A Link with href and rel",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@type": "urn:solid:Link",
        "urn:solid:href": { "@id": "https://example.org/article/42" },
        "urn:solid:rel": "canonical"
      }
    }
  ],
