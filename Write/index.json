  "rdfs:label": "Write",
  "rdfs:comment": "The WAC Write access mode — permission to modify or delete the contents of a resource.",
  "owl:sameAs": "http://www.w3.org/ns/auth/acl#Write",
  "rdfs:seeAlso": [
