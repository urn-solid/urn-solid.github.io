{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Event",
  "@type": "rdfs:Class",
  "rdfs:label": "Event",
  "rdfs:comment": "An event happening at a certain time and (often) location.",
  "owl:sameAs": "https://schema.org/Event",
  "rdfs:seeAlso": [
    "https://www.w3.org/ns/activitystreams#Event",
    "urn:solid:Vevent"
  ],
  "notToBeConfusedWith": [
    "urn:solid:Vevent"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Use for scheduled occurrences — meetings, conferences, releases, performances. Pair with `schema:startDate`, `schema:endDate`, `schema:location`. For calendar data that must round-trip with iCalendar/RFC 5545 (dtstart, rrule, valarm), use `urn:solid:Vevent`; use `urn:solid:Event` for schema.org web/SEO markup; use `as:Event` in ActivityPub.",
  "examples": [
    {
      "title": "A simple event",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/events/launch",
        "@type": "urn:solid:Event",
        "urn:solid:name": "urn-solid launch",
        "https://schema.org/startDate": "2026-04-18T18:00:00Z",
        "https://schema.org/location": { "@id": "https://example.org/places/wonderland-hq" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://schema.org/Event"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-18T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    },
    {
      "event": "updated",
      "at": "2026-10-29T00:00:00Z",
      "by": "urn-solid-review",
      "note": "Disambiguated from urn:solid:Vevent (iCalendar) and as:Event."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  }
}
