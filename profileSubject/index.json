  "rdfs:range": "urn:solid:Person",
  "notToBeConfusedWith": [
    "urn:solid:primaryTopic"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Solid-specific name for the relation FOAF expresses as `foaf:primaryTopic`. Use on a profile document to point at the Person it describes. Most existing data uses `foaf:primaryTopic`; this is the modern Solid-namespaced equivalent.",
  "examples": [
    {
      "title": "Profile document with subject",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://alice.example.org/profile/card",
        "@type": "urn:solid:PersonalProfileDocument",
        "urn:solid:profileSubject": { "@id": "https://alice.example.org/profile/card#me" }
      }
    }
  ],
