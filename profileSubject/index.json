  "@id": "urn:solid:profileSubject",
  "@type": "rdf:Property",
  "rdfs:label": "profileSubject",
  "rdfs:comment": "The subject (Person) that a profile document is about.",
  "owl:sameAs": "http://www.w3.org/ns/solid/terms#profileSubject",
  "rdfs:seeAlso": [
    "urn:solid:primaryTopic",
    "urn:solid:isPrimaryTopicOf"
