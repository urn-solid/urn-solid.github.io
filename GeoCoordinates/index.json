    "urn:solid:hasGeo"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Carries `schema:latitude` and `schema:longitude` (decimal degrees, WGS-84) and optional `schema:elevation`. Use as the value of `schema:geo` on a Place. For a `geo:` URI shortcut, see `urn:solid:hasGeo`. For shapes (polygons), use `schema:GeoShape`.",
  "examples": [
    {
      "title": "Coordinates for a place",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/places/big-ben/geo",
        "@type": "urn:solid:GeoCoordinates",
        "https://schema.org/latitude": "51.5007",
        "https://schema.org/longitude": "-0.1246"
      }
    }
  ],
