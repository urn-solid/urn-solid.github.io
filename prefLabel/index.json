{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:prefLabel",
  "@type": "rdf:Property",
  "rdfs:label": "prefLabel",
  "rdfs:comment": "The preferred lexical label for a SKOS Concept — its canonical name in a given language.",
  "owl:sameAs": "http://www.w3.org/2004/02/skos/core#prefLabel",
  "rdfs:seeAlso": [
    "urn:solid:altLabel",
    "urn:solid:hiddenLabel",
    "http://www.w3.org/2000/01/rdf-schema#label"
  ],
  "rdfs:domain": "urn:solid:Concept",
  "rdfs:range": "http://www.w3.org/2001/XMLSchema#string",
  "notToBeConfusedWith": [
    "urn:solid:altLabel"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Exactly one `prefLabel` per language tag per Concept (SKOS integrity rule). Use language-tagged literals for multilingual vocabularies. Synonyms go under `urn:solid:altLabel`; non-display strings (typos, misspellings used for search) go under `urn:solid:hiddenLabel`.",
  "examples": [
    {
      "title": "Multilingual concept label",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/vocab/topics/cat-theory",
        "@type": "urn:solid:Concept",
        "urn:solid:prefLabel": [
          { "@value": "Category theory", "@language": "en" },
          { "@value": "Kategorientheorie", "@language": "de" }
        ]
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2004/02/skos/core#prefLabel"
    ],
    "curatedBy": "claude-curate-next"
  },
