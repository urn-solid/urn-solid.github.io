    "urn:solid:Organization"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Subclass of `urn:solid:Agent`. Use for any collection of agents — friends, mailing-list subscribers, project contributors. Use `urn:solid:Organization` when the collective has formal/legal structure. Members are listed with `urn:solid:member`.",
  "examples": [
    {
      "title": "A simple Group",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://example.org/groups/admins",
        "@type": "urn:solid:Group",
        "urn:solid:name": "Admins",
        "urn:solid:member": [
          { "@id": "https://example.org/alice#me" },
          { "@id": "https://example.org/bob#me" }
        ]
      }
    }
  ],
