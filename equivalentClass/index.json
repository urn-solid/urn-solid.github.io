{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:equivalentClass",
  "@type": "rdf:Property",
  "rdfs:label": "equivalentClass",
  "rdfs:comment": "Asserts that two OWL classes have identical extensions — every instance of one is also an instance of the other and vice versa.",
  "owl:sameAs": "http://www.w3.org/2002/07/owl#equivalentClass",
  "rdfs:seeAlso": [
    "urn:solid:Class",
    "urn:solid:subClassOf",
    "urn:solid:sameAs",
    "urn:solid:equivalentProperty"
  ],
  "rdfs:domain": "urn:solid:Class",
  "rdfs:range": "urn:solid:Class",
  "notToBeConfusedWith": [
    "urn:solid:sameAs",
    "urn:solid:subClassOf"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Stronger than mutual `subClassOf` — `equivalentClass` is two-way subclass, but as a single assertion it makes the equivalence explicit for reasoners. Distinct from `owl:sameAs`, which equates *individuals*. Use to bridge two parallel class hierarchies (e.g. `foaf:Person` and `schema:Person`).",
  "examples": [
    {
      "title": "Two upstream Person classes equated",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "http://xmlns.com/foaf/0.1/Person",
        "urn:solid:equivalentClass": { "@id": "https://schema.org/Person" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2002/07/owl#equivalentClass"
    ],
    "curatedBy": "claude-curate-next"
  },
