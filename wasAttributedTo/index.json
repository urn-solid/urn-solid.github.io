{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:wasAttributedTo",
  "@type": "rdf:Property",
  "rdfs:label": "wasAttributedTo",
  "rdfs:comment": "An agent to which the entity is attributed — without claiming the agent performed any specific action.",
  "owl:sameAs": "http://www.w3.org/ns/prov#wasAttributedTo",
  "rdfs:seeAlso": [
    "urn:solid:attributedTo",
    "urn:solid:creator",
    "urn:solid:qualifiedAttribution",
    "urn:solid:wasAssociatedWith"
  ],
  "rdfs:domain": "urn:solid:Entity",
  "rdfs:range": "http://www.w3.org/ns/prov#Agent",
  "notToBeConfusedWith": [
    "urn:solid:attributedTo",
    "urn:solid:creator",
    "urn:solid:wasAssociatedWith"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Implies the Entity was generated by some unspecified Activity associated with this Agent; use when the activity itself is not modelled. For richer attribution with a role, qualify via `prov:qualifiedAttribution` and a `prov:Attribution` resource.",
  "examples": [
    {
      "title": "Document attributed to a person",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/papers/42",
        "@type": "urn:solid:Entity",
        "urn:solid:wasAttributedTo": { "@id": "https://example.org/alice#me" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/prov#wasAttributedTo"
    ],
    "curatedBy": "claude-curate-next"
  },
