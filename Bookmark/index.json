{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Bookmark",
  "@type": "rdfs:Class",
  "rdfs:label": "Bookmark",
  "rdfs:comment": "A saved reference to a web resource — title, URL, optional tags and notes.",
  "owl:sameAs": "http://www.w3.org/2002/01/bookmark#Bookmark",
  "rdfs:seeAlso": [
    "urn:solid:recalls",
    "urn:solid:hasTopic",
    "https://schema.org/BookmarkAction"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "The W3C bookmark vocabulary class used by Tabulator/SolidOS. A Bookmark uses `urn:solid:recalls` for the URL it points at and `urn:solid:hasTopic` for the Topic (folder) it is filed under. Pair with `urn:solid:title` for the headline and `urn:solid:created` for the save date.",
  "examples": [
    {
      "title": "A bookmark filed under topics",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/bookmarks/solid",
        "@type": "urn:solid:Bookmark",
        "urn:solid:title": "Solid Project",
        "urn:solid:recalls": { "@id": "https://solidproject.org/" },
        "urn:solid:hasTopic": [
          { "@id": "https://alice.example.org/bookmarks/topics#solid" },
          { "@id": "https://alice.example.org/bookmarks/topics#decentralization" }
        ]
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2002/01/bookmark#Bookmark"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    },
    {
      "event": "updated",
      "at": "2026-10-29T00:00:00Z",
      "by": "urn-solid-review",
      "note": "Example uses urn:solid:title/recalls/hasTopic with Topic IRIs instead of plain-string tags; notes describe hasTopic as topic folders."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  }
}
