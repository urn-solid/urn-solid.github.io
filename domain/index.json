{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:domain",
  "@type": "rdf:Property",
  "rdfs:label": "domain",
  "rdfs:comment": "States that any resource used as the subject of a property is an instance of the given class — an inference rule, not a validation constraint.",
  "owl:sameAs": "http://www.w3.org/2000/01/rdf-schema#domain",
  "rdfs:seeAlso": [
    "urn:solid:Property",
    "urn:solid:range",
    "urn:solid:Class"
  ],
  "rdfs:domain": "urn:solid:Property",
  "rdfs:range": "urn:solid:Class",
  "notToBeConfusedWith": [
    "urn:solid:range"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Subject-side inference (not validation — use SHACL to reject data): `acl:agent` has domain `acl:Authorization` because authorisations are what carry it. Multiple domain triples mean subjects are inferred to be instances of *all* the listed classes (intersection), not any of them — a common trap.",
  "examples": [
    {
      "title": "Property declaring its subject type",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "urn:solid:agent",
        "@type": "urn:solid:Property",
        "urn:solid:domain": { "@id": "urn:solid:Authorization" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2000/01/rdf-schema#domain"
    ],
    "curatedBy": "claude-curate-next"
  },
