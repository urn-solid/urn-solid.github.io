{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:type",
  "@type": "rdf:Property",
  "rdfs:label": "type",
  "rdfs:comment": "Asserts that a resource is an instance of a class — the predicate behind JSON-LD's `@type` keyword.",
  "owl:sameAs": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
  "rdfs:seeAlso": [
    "urn:solid:Class",
    "urn:solid:subClassOf"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "The most-used predicate in all of RDF. JSON-LD authors usually write `@type: \"Person\"`; the underlying triple is `<subject> rdf:type urn:solid:Person`. A subject can have many types simultaneously (multi-typing is normal in RDF, unlike most class-based languages).",
  "examples": [
    {
      "title": "An instance of multiple classes",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://alice.example.org/profile/card#me",
        "urn:solid:type": [
          { "@id": "urn:solid:Person" },
          { "@id": "urn:solid:Agent" }
        ]
      }
    }
  ],
  "provenance": {
