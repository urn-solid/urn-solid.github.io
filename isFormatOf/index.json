{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:isFormatOf",
  "@type": "rdf:Property",
  "rdfs:label": "isFormatOf",
  "rdfs:comment": "A related resource that is the same intellectual content of which the described resource is a different-format rendition.",
  "owl:sameAs": "http://purl.org/dc/terms/isFormatOf",
  "rdfs:seeAlso": [
    "urn:solid:hasFormat"
  ],
  "notToBeConfusedWith": [
    "urn:solid:hasFormat",
    "urn:solid:isVersionOf"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Inverse of `urn:solid:hasFormat`. Use on the alternate-format rendition to point at the canonical resource it represents in another format. Distinct from `isVersionOf` (different version/edition, not just different format).",
  "examples": [
    {
      "title": "PDF pointing at canonical HTML",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://example.org/papers/42.pdf",
        "@type": "urn:solid:Document",
        "urn:solid:isFormatOf": { "@id": "https://example.org/papers/42" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://purl.org/dc/terms/isFormatOf"
    ],
