  "@id": "urn:solid:isPrimaryTopicOf",
  "@type": "rdf:Property",
  "rdfs:label": "isPrimaryTopicOf",
  "rdfs:comment": "A document of which the subject is the primary topic — the inverse of `primaryTopic`.",
  "owl:sameAs": "http://xmlns.com/foaf/0.1/isPrimaryTopicOf",
  "rdfs:seeAlso": [
    "urn:solid:primaryTopic",
    "urn:solid:page"
  ],
  "rdfs:range": "urn:solid:Document",
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Use on a Person (or other thing) to point at the document that primarily describes them. The canonical case is a WebID: `<#me> foaf:isPrimaryTopicOf <profile-card>`. Inverse-functional in FOAF — the document uniquely identifies the subject, and vice versa.",
  "examples": [
    {
      "title": "Person pointing to their profile document",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://alice.example.org/profile/card#me",
        "@type": "urn:solid:Person",
        "urn:solid:isPrimaryTopicOf": { "@id": "https://alice.example.org/profile/card" }
      }
    }
  ],
