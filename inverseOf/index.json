{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:inverseOf",
  "@type": "rdf:Property",
  "rdfs:label": "inverseOf",
  "rdfs:comment": "Asserts that two OWL properties are inverses — `A p1 B` if and only if `B p2 A`.",
  "owl:sameAs": "http://www.w3.org/2002/07/owl#inverseOf",
  "rdfs:seeAlso": [
    "urn:solid:Property",
    "urn:solid:equivalentProperty"
  ],
  "rdfs:domain": "urn:solid:Property",
  "rdfs:range": "urn:solid:Property",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Reasoners use this to materialise the reverse direction without storing both. Classic pairs: `as:followers` / `as:following`, `dcterms:isPartOf` / `dcterms:hasPart`, `prov:wasGeneratedBy` / `prov:generated`. Symmetric properties (`owl:sameAs`, `foaf:knows`) are their own inverse.",
  "examples": [
    {
      "title": "isPartOf and hasPart as inverses",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "urn:solid:isPartOf",
        "urn:solid:inverseOf": { "@id": "urn:solid:hasPart" }
      }
    }
  ],
