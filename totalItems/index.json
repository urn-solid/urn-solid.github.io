{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:totalItems",
  "@type": "rdf:Property",
  "rdfs:label": "totalItems",
  "rdfs:comment": "The total number of members in an ActivityStreams Collection — the size the client would see if all pages were concatenated.",
  "owl:sameAs": "http://www.w3.org/ns/activitystreams#totalItems",
  "rdfs:seeAlso": [
    "urn:solid:Collection",
    "urn:solid:items",
    "urn:solid:first",
    "urn:solid:partOf"
  ],
  "rdfs:domain": "urn:solid:Collection",
  "rdfs:range": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Authoritative count even when the Collection is paginated and only a subset of `items` is materialised in any given response. Drives \"42 likes\" / \"123 followers\" UI without forcing the client to walk the entire pagination chain.",
  "examples": [
    {
      "title": "Followers Collection summary",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/followers",
        "@type": "urn:solid:Collection",
        "urn:solid:totalItems": 1247,
        "urn:solid:first": { "@id": "https://alice.example.org/followers?page=1" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/activitystreams#totalItems"
    ],
