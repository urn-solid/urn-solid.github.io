  "@id": "urn:solid:topic",
  "@type": "rdf:Property",
  "rdfs:label": "topic",
  "rdfs:comment": "A thing the document is about — the inverse of `page`.",
  "owl:sameAs": "http://xmlns.com/foaf/0.1/topic",
  "rdfs:seeAlso": [
    "https://schema.org/about",
    "urn:solid:page",
    "urn:solid:primaryTopic"
  ],
