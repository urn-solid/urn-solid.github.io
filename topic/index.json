  "notToBeConfusedWith": [
    "urn:solid:primaryTopic"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "A document can have many `topic`s with no implied primacy. Use `urn:solid:primaryTopic` when one topic is the principal subject (one per document). The inverse `urn:solid:page` goes from subject → document.",
  "examples": [
    {
      "title": "Document about two people",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/posts/conversation",
        "@type": "urn:solid:Document",
        "urn:solid:topic": [
          { "@id": "https://example.org/alice#me" },
          { "@id": "https://example.org/bob#me" }
        ]
      }
    }
  ],
