{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:OrganizationalUnit",
  "@type": "rdfs:Class",
  "rdfs:label": "OrganizationalUnit",
  "rdfs:comment": "An ORG OrganizationalUnit — a part of a larger Organization (department, team, division) without independent legal status.",
  "owl:sameAs": "http://www.w3.org/ns/org#OrganizationalUnit",
  "rdfs:seeAlso": [
    "urn:solid:Organization",
    "urn:solid:FormalOrganization",
    "urn:solid:subOrganizationOf"
  ],
  "notToBeConfusedWith": [
    "urn:solid:FormalOrganization"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Subclass of `urn:solid:Organization`. Distinguishes internal divisions from legally-recognized entities (which use `urn:solid:FormalOrganization`). Pair with `urn:solid:subOrganizationOf` to point at the parent.",
  "examples": [
    {
      "title": "An engineering team within a company",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/orgs/acme/eng",
        "@type": "urn:solid:OrganizationalUnit",
        "urn:solid:name": "Engineering",
        "urn:solid:subOrganizationOf": { "@id": "https://example.org/orgs/acme-ltd" }
      }
    }
  ],
