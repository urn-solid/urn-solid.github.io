  "@type": "rdf:Property",
  "rdfs:label": "accountServiceHomepage",
  "rdfs:comment": "The homepage of the online service that hosts the account.",
  "owl:sameAs": "http://xmlns.com/foaf/0.1/accountServiceHomepage",
  "rdfs:domain": "urn:solid:OnlineAccount",
  "rdfs:range": "urn:solid:Document",
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Pair with `urn:solid:accountName` so the combination uniquely identifies the account: the value here is the service's root URL (e.g. `https://github.com/`), not the account-specific URL (`https://github.com/alice`).",
  "examples": [
    {
      "title": "GitHub account",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://example.org/alice/accounts/github",
        "@type": "urn:solid:OnlineAccount",
        "urn:solid:accountName": "alice",
        "urn:solid:accountServiceHomepage": { "@id": "https://github.com/" }
      }
    }
  ],
