{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:thumbnail",
  "@type": "rdf:Property",
  "rdfs:label": "thumbnail",
  "rdfs:comment": "A derived thumbnail image for a document — typically a smaller preview rendition of an image, or a preview picture of another document.",
  "owl:sameAs": "http://xmlns.com/foaf/0.1/thumbnail",
  "rdfs:seeAlso": [
    "https://schema.org/thumbnailUrl"
  ],
  "rdfs:domain": "urn:solid:Document",
  "rdfs:range": "urn:solid:Document",
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Use on a full-size image to point at a smaller preview rendition. Upstream domain and range are `foaf:Document`, so thumbnails of non-image documents are allowed; most often both are `urn:solid:Image`. For richer image-object metadata (width, height, content URL), schema:ImageObject + schema:thumbnail carry more fields.",
  "examples": [
    {
      "title": "Image with a thumbnail",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/photos/sunset.jpg",
        "@type": "urn:solid:Image",
        "urn:solid:thumbnail": { "@id": "https://example.org/photos/sunset-thumb.jpg" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://xmlns.com/foaf/0.1/thumbnail"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-18T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    },
    {
      "event": "updated",
      "at": "2026-10-29T00:00:00Z",
      "by": "urn-solid-review",
      "note": "Widened domain/range to urn:solid:Document to match upstream foaf:thumbnail; updated comment and notes."
    },
    {
      "event": "updated",
      "at": "2026-10-29T00:00:00Z",
      "by": "urn-solid-review",
      "note": "Added reciprocal notToBeConfusedWith links."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  },
  "notToBeConfusedWith": [
    "urn:solid:preview"
  ]
}
