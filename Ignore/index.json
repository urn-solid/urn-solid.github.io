  "@id": "urn:solid:Ignore",
  "@type": "rdfs:Class",
  "rdfs:label": "Ignore",
  "rdfs:comment": "An ActivityStreams Activity indicating that the actor is silently disregarding the object — a soft mute, distinct from Block.",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#Ignore",
  "rdfs:seeAlso": [
    "urn:solid:Block",
    "urn:solid:Flag",
    "urn:solid:Reject"
  ],
  "notToBeConfusedWith": [
    "urn:solid:Block",
    "urn:solid:Reject",
    "urn:solid:Flag"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Records that the actor is ignoring the object (e.g. dismissing a notification or muting a thread). Unlike Block it implies no enforcement against the object's author; unlike Reject it is not a response to a request. Little interoperable server behaviour is attached to it.",
  "examples": [
    {
      "title": "Ignoring a notification",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/activities/ignore-1",
        "@type": "urn:solid:Ignore",
        "urn:solid:actor": { "@id": "https://alice.example.org/profile/card#me" },
        "urn:solid:object": { "@id": "https://example.org/notifications/47" }
      }
    }
  ],
