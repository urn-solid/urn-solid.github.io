{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:Ignore",
  "@type": "rdfs:Class",
  "rdfs:label": "Ignore",
  "rdfs:comment": "An ActivityStreams Activity indicating that the actor is silently disregarding the object — a soft mute, distinct from Block.",
  "owl:sameAs": "http://www.w3.org/ns/activitystreams#Ignore",
  "rdfs:seeAlso": [
    "urn:solid:Block",
    "urn:solid:Flag",
    "urn:solid:Reject"
  ],
  "notToBeConfusedWith": [
    "urn:solid:Block",
    "urn:solid:Reject"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Lighter-touch than `Block`: typically not federated to the target (the target shouldn't know they were ignored), and the relationship persists. Distinct from `Reject` (which actively declines a request) — `Ignore` is one-sided, internal to the actor.",
  "examples": [
    {
      "title": "Ignoring a notification",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://alice.example.org/activities/ignore-1",
        "@type": "urn:solid:Ignore",
        "urn:solid:actor": { "@id": "https://alice.example.org/profile/card#me" },
        "urn:solid:object": { "@id": "https://example.org/notifications/47" }
      }
    }
  ],
