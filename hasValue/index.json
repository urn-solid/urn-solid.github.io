{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:hasValue",
  "@type": "rdf:Property",
  "rdfs:label": "hasValue",
  "rdfs:comment": "On an OWL Restriction, asserts that the constrained property must have one specific value — the most precise form of class definition.",
  "owl:sameAs": "http://www.w3.org/2002/07/owl#hasValue",
  "rdfs:seeAlso": [
    "urn:solid:Restriction",
    "urn:solid:onProperty",
    "urn:solid:allValuesFrom",
    "urn:solid:someValuesFrom"
  ],
  "rdfs:domain": "urn:solid:Restriction",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "\"On property X, the value must be exactly this.\" Use to define classes like \"Things whose `acl:mode` includes `acl:Read`.\" Value can be any individual or literal. Stronger than `someValuesFrom` (which only constrains the type, not the specific value).",
  "examples": [
    {
      "title": "A class of resources granting public read",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@type": "urn:solid:Restriction",
        "urn:solid:onProperty": { "@id": "urn:solid:agentClass" },
        "urn:solid:hasValue": { "@id": "http://xmlns.com/foaf/0.1/Agent" }
      }
    }
  ],
