  "@id": "urn:solid:Activity",
  "@type": "rdfs:Class",
  "rdfs:label": "Activity",
  "rdfs:comment": "An action taken by an actor — the base for Create, Like, Follow, Announce, etc.",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#Activity",
