  ],
  "rdfs:domain": "urn:solid:Container",
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Used on a `DirectContainer` or `IndirectContainer` to declare which predicate the server should add when a new resource is POSTed — e.g. `schema:comment` so a new POST to a comments container produces `<post> schema:comment <new-comment>`. Alternative: `ldp:isMemberOfRelation` for the inverse direction.",
  "examples": [
    {
      "title": "Comments container declaring its member relation",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/posts/abc/comments/",
        "@type": "urn:solid:DirectContainer",
        "urn:solid:membershipResource": { "@id": "https://example.org/posts/abc" },
        "urn:solid:hasMemberRelation": { "@id": "https://schema.org/comment" }
      }
    }
