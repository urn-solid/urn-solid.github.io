  "@id": "urn:solid:anniversary",
  "@type": "rdf:Property",
  "rdfs:label": "anniversary",
  "rdfs:comment": "The date of marriage, or equivalent, of the subject (RFC 6350 ANNIVERSARY).",
  "owl:sameAs": "http://www.w3.org/2006/vcard/ns#anniversary",
  "rdfs:seeAlso": [
    "urn:solid:bday",
    "urn:solid:birthday"
  ],
  "rdfs:range": "http://www.w3.org/2001/XMLSchema#date",
  "notToBeConfusedWith": [
    "urn:solid:bday",
    "urn:solid:birthday"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "vCard's ANNIVERSARY field — distinct from `urn:solid:birthday`/`urn:solid:bday`. ISO 8601 date. At most one value per card; for an organization founding date use schema:foundingDate. The registry range is xsd:date, but upstream declares xsd:dateTime | xsd:gYear.",
  "examples": [
    {
      "title": "Person with an anniversary",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/cards/alice",
        "@type": "urn:solid:VCard",
        "urn:solid:fn": "Alice Liddell",
        "urn:solid:anniversary": "2010-06-15"
      }
    }
  ],
