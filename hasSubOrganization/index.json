  "rdfs:domain": "urn:solid:Organization",
  "rdfs:range": "urn:solid:Organization",
  "notToBeConfusedWith": [
    "urn:solid:subOrganizationOf"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Inverse of `urn:solid:subOrganizationOf`. Use to enumerate departments/units belonging to a parent. Repeat for multiple subunits.",
  "examples": [
    {
      "title": "Company with engineering and sales units",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/orgs/acme-ltd",
        "@type": "urn:solid:FormalOrganization",
        "urn:solid:hasSubOrganization": [
          { "@id": "https://example.org/orgs/acme/eng" },
          { "@id": "https://example.org/orgs/acme/sales" }
        ]
      }
    }
  ],
