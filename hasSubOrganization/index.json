  "@type": "rdf:Property",
  "rdfs:label": "hasSubOrganization",
  "rdfs:comment": "An OrganizationalUnit (department, team, division) that is part of the parent Organization.",
  "owl:sameAs": "http://www.w3.org/ns/org#hasSubOrganization",
  "rdfs:seeAlso": [
    "urn:solid:subOrganizationOf",
    "urn:solid:OrganizationalUnit"
