{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Property",
  "@type": "rdfs:Class",
  "rdfs:label": "Property",
  "rdfs:comment": "The class of RDF properties — predicates that connect a subject to a value (`name`, `knows`, `published`, etc.).",
  "owl:sameAs": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property",
  "rdfs:seeAlso": [
    "urn:solid:Class",
    "urn:solid:subPropertyOf",
    "urn:solid:domain",
    "urn:solid:range"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Foundational RDF term. Every property definition in this registry is `@type: rdf:Property`. Pair with `rdfs:domain` (subject types) and `rdfs:range` (value types) to constrain usage.",
  "examples": [
    {
      "title": "Declaring a custom property",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/vocab/sport",
        "@type": "urn:solid:Property",
        "urn:solid:domain": { "@id": "https://example.org/vocab/Athlete" },
        "urn:solid:range": { "@id": "http://www.w3.org/2001/XMLSchema#string" }
      }
    }
  ],
