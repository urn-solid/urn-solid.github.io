{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:OrderedCollection",
  "@type": "rdfs:Class",
  "rdfs:label": "OrderedCollection",
  "rdfs:comment": "An ordered collection of objects — most-recent-first by convention in ActivityPub.",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#OrderedCollection",
  "rdfs:seeAlso": [
    "urn:solid:Collection"
  ],
  "notToBeConfusedWith": [
    "urn:solid:Collection"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Subclass of `urn:solid:Collection`. The shape used by ActivityPub inboxes and outboxes. Members are enumerated via `as:orderedItems` (or paginated via `as:first`/`as:next`); items are typically sorted reverse-chronologically.",
  "examples": [
    {
      "title": "An outbox as an OrderedCollection",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://example.org/alice/outbox",
        "@type": "urn:solid:OrderedCollection",
        "https://www.w3.org/ns/activitystreams#totalItems": 2,
        "https://www.w3.org/ns/activitystreams#orderedItems": [
          { "@id": "https://example.org/activities/2" },
          { "@id": "https://example.org/activities/1" }
        ]
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://www.w3.org/ns/activitystreams#OrderedCollection"
    ],
    "curatedBy": "claude-curate-next"
  },
