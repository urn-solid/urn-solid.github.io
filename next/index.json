{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:next",
  "@type": "rdf:Property",
  "rdfs:label": "next",
  "rdfs:comment": "The next page in an ActivityStreams CollectionPage chain — the URL the client follows to advance through pagination.",
  "owl:sameAs": "http://www.w3.org/ns/activitystreams#next",
  "rdfs:seeAlso": [
    "urn:solid:Collection",
    "urn:solid:prev",
    "urn:solid:first",
    "urn:solid:last",
    "urn:solid:partOf"
  ],
  "rdfs:domain": "http://www.w3.org/ns/activitystreams#CollectionPage",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Present on every CollectionPage except the last. Clients walk pagination by repeatedly fetching `next` until it's absent — that's the termination signal, not a count check against `totalItems`. Pair with `prev` for bidirectional scrolling.",
  "examples": [
    {
      "title": "A CollectionPage linking to the next page",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/outbox?page=1",
        "@type": "http://www.w3.org/ns/activitystreams#OrderedCollectionPage",
        "urn:solid:partOf": { "@id": "https://alice.example.org/outbox" },
        "urn:solid:next": { "@id": "https://alice.example.org/outbox?page=2" }
      }
    }
  ],
