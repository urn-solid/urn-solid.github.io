{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:oidcIssuer",
  "@type": "rdf:Property",
  "rdfs:label": "oidcIssuer",
  "rdfs:comment": "The OpenID Connect issuer that this WebID trusts to authenticate it.",
  "owl:sameAs": "http://www.w3.org/ns/solid/terms#oidcIssuer",
  "rdfs:seeAlso": [
    "urn:solid:openid"
  ],
  "rdfs:domain": "urn:solid:Person",
  "notToBeConfusedWith": [
    "urn:solid:openid"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "The Solid OIDC trust anchor: the value is the issuer URL of the OpenID Provider whose tokens this WebID will accept. A WebID may list multiple `oidcIssuer` values for redundancy. Distinct from the older FOAF `urn:solid:openid` (a document-based pre-OIDC scheme).",
  "examples": [
    {
      "title": "WebID with a Solid OIDC issuer",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/profile/card#me",
        "@type": "urn:solid:Person",
        "urn:solid:oidcIssuer": { "@id": "https://login.example.org/" }
      }
    }
  ],
