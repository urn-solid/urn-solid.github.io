{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:role",
  "@type": "rdf:Property",
  "rdfs:label": "role",
  "rdfs:comment": "The function or part the subject plays in an organization or situation (RFC 6350 ROLE), e.g. \"Project Leader\", \"Treasurer\" — not the formal job title.",
  "owl:sameAs": "http://www.w3.org/2006/vcard/ns#role",
  "rdfs:seeAlso": [
    "http://www.w3.org/2006/vcard/ns#title",
    "https://schema.org/jobTitle",
    "urn:solid:worksFor"
  ],
  "rdfs:range": "http://www.w3.org/2001/XMLSchema#string",
  "status": "stable",
  "added": "2026-04-18",
  "notes": "vCard's role string (RFC 6350 ROLE) — the function performed, not the job title. For the formal job title use vcard:title (http://www.w3.org/2006/vcard/ns#title) / schema:jobTitle. For PROV-grade role-in-Activity attribution, use `prov:hadRole`.",
  "examples": [
    {
      "title": "vCard with a role",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/cards/alice-work",
        "@type": "urn:solid:VCard",
        "urn:solid:fn": "Alice Liddell",
        "urn:solid:organization-name": "Acme Corp",
        "urn:solid:role": "Project Leader"
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2006/vcard/ns#role"
    ],
    "curatedBy": "claude-curate-next"
  },
