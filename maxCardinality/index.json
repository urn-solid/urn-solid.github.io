{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:maxCardinality",
  "@type": "rdf:Property",
  "rdfs:label": "maxCardinality",
  "rdfs:comment": "On an OWL Restriction, asserts that the constrained property must have *at most* this many values.",
  "owl:sameAs": "http://www.w3.org/2002/07/owl#maxCardinality",
  "rdfs:seeAlso": [
    "urn:solid:Restriction",
    "urn:solid:minCardinality",
    "urn:solid:cardinality",
    "urn:solid:onProperty"
  ],
  "rdfs:domain": "urn:solid:Restriction",
  "rdfs:range": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "`maxCardinality 1` is how you say \"this is functional\" inside a class definition without globally declaring the property `owl:FunctionalProperty`. Useful when functionality only holds in the context of a particular class.",
  "examples": [
    {
      "title": "Class restricting to at most 5 authors",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@type": "urn:solid:Restriction",
        "urn:solid:onProperty": { "@id": "urn:solid:author" },
        "urn:solid:maxCardinality": 5
      }
    }
  ],
