{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:ObjectProperty",
  "@type": "rdfs:Class",
  "rdfs:label": "ObjectProperty",
  "rdfs:comment": "An OWL property whose values are individuals (other resources, identified by IRI or blank node) — never literal strings, numbers, or dates.",
  "owl:sameAs": "http://www.w3.org/2002/07/owl#ObjectProperty",
  "rdfs:seeAlso": [
    "urn:solid:Property",
    "urn:solid:DatatypeProperty"
  ],
  "notToBeConfusedWith": [
    "urn:solid:DatatypeProperty"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Examples: `foaf:knows`, `as:actor`, `dcterms:creator`. Distinct from `owl:DatatypeProperty` (whose values are literals like \"Alice\" or 42). The split helps reasoners and tooling — an ObjectProperty value is dereferenceable, a DatatypeProperty value is not.",
  "examples": [
    {
      "title": "Declaring as:actor as an ObjectProperty",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "urn:solid:actor",
        "@type": "urn:solid:ObjectProperty",
        "urn:solid:range": { "@id": "urn:solid:Actor" }
      }
    }
  ],
  "provenance": {
