{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Vtodo",
  "@type": "rdfs:Class",
  "rdfs:label": "Vtodo",
  "rdfs:comment": "An iCalendar to-do item — a task that can be in progress, completed, or cancelled, with optional due dates.",
  "owl:sameAs": "http://www.w3.org/2002/12/cal/ical#Vtodo",
  "rdfs:seeAlso": [
    "urn:solid:Vevent",
    "urn:solid:Vcalendar",
    "urn:solid:dtstart"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "The iCal task primitive — every native to-do/reminder app on macOS, iOS, Windows, and Linux understands this. Pairs with CalDAV for sync. `ical:due` is the key date for a to-do; `ical:status` takes NEEDS-ACTION, IN-PROCESS, COMPLETED or CANCELLED. In LOSOS the todo pane is registered on `urn:solid:Tracker` (the list); individual Vtodos render inside it.",
  "examples": [
    {
      "title": "A simple to-do item",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/todos/buy-milk",
        "@type": "urn:solid:Vtodo",
        "http://www.w3.org/2002/12/cal/ical#summary": "Buy milk",
        "urn:solid:dtstart": {
          "@value": "2026-04-19T17:00:00Z",
          "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
        },
        "http://www.w3.org/2002/12/cal/ical#due": {
          "@value": "2026-04-19T19:00:00Z",
          "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
        },
        "http://www.w3.org/2002/12/cal/ical#status": "NEEDS-ACTION"
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2002/12/cal/ical#Vtodo"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
