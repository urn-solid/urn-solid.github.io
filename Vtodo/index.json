  "@type": "rdfs:Class",
  "rdfs:label": "Vtodo",
  "rdfs:comment": "An iCalendar to-do item — a task that can be in progress, completed, or cancelled, with optional due dates.",
  "owl:sameAs": "http://www.w3.org/2002/12/cal/ical#Vtodo",
  "rdfs:seeAlso": [
    "urn:solid:Vevent",
    "urn:solid:Vcalendar",
    "urn:solid:dtstart"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "The iCal task primitive — every native to-do/reminder app on macOS, iOS, Windows, and Linux understands this. Pairs with CalDAV for sync. Already used by LOSOS: the default registry maps `ical:Vtodo` to the todo pane, so urn:solid:Vtodo is the cross-vocab canonical form for that pane.",
