      "note": "Initial term."
    },
    {
      "event": "updated",
      "at": "2026-10-29T00:00:00Z",
      "by": "urn-solid-review",
      "note": "Notes aligned with Tracker (LOSOS todo pane is on Tracker); mention ical:due and ical:status; example adds summary, due and status."
    },
    {
