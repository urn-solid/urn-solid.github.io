{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:following",
  "@type": "rdf:Property",
  "rdfs:label": "following",
  "rdfs:comment": "The Collection of actors that an ActivityPub actor (Person, Application, Group, Organization or Service) follows — the source side of the social graph.",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#following",
  "rdfs:seeAlso": [
    "urn:solid:followers",
    "urn:solid:Follow"
  ],
  "notToBeConfusedWith": [
    "urn:solid:followers",
    "urn:solid:follower"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Defined by ActivityPub (§5.4), not the AS2 Vocabulary. Mirror of `as:followers`. Each entry is an actor whose Activities the subject has subscribed to via a `Follow` activity. May be private (just a count) for privacy-sensitive deployments.",
  "examples": [
    {
      "title": "A Person exposing a following Collection",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/profile/card#me",
        "@type": "urn:solid:Person",
        "urn:solid:following": { "@id": "https://alice.example.org/following" }
      }
    }
  ],
  "provenance": {
