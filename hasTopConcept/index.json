{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:hasTopConcept",
  "@type": "rdf:Property",
  "rdfs:label": "hasTopConcept",
  "rdfs:comment": "A top-level (entry-point) Concept of a SKOS ConceptScheme, by convention one with no broader concept in that scheme. Inverse of topConceptOf.",
  "owl:sameAs": "http://www.w3.org/2004/02/skos/core#hasTopConcept",
  "rdfs:seeAlso": [
    "urn:solid:topConceptOf",
    "urn:solid:ConceptScheme",
    "urn:solid:inScheme"
  ],
  "rdfs:domain": "urn:solid:ConceptScheme",
  "rdfs:range": "urn:solid:Concept",
  "notToBeConfusedWith": [
    "urn:solid:topConceptOf"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Use on a ConceptScheme to enumerate its entry-point Concepts — by convention those with no `broader` parent in the scheme (not a SKOS integrity condition). Inverse is `urn:solid:topConceptOf`. A scheme typically has a small handful of top concepts; repeat for each.",
  "examples": [
    {
      "title": "Scheme with two top concepts",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/vocab/topics",
        "@type": "urn:solid:ConceptScheme",
        "urn:solid:hasTopConcept": [
          { "@id": "https://example.org/vocab/topics/math" },
          { "@id": "https://example.org/vocab/topics/cs" }
        ]
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2004/02/skos/core#hasTopConcept"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    },
    {
      "event": "updated",
      "at": "2026-10-29T00:00:00Z",
      "by": "urn-solid-review",
      "note": "Reworded 'no broader concept in the scheme' as a convention, not a SKOS rule."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
