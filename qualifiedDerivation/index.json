{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:qualifiedDerivation",
  "@type": "rdf:Property",
  "rdfs:label": "qualifiedDerivation",
  "rdfs:comment": "A qualified PROV Derivation linked to the entity — adds role, activity, and other context to a `wasDerivedFrom` relation.",
  "owl:sameAs": "http://www.w3.org/ns/prov#qualifiedDerivation",
  "rdfs:seeAlso": [
    "urn:solid:Derivation",
    "urn:solid:wasDerivedFrom"
  ],
  "rdfs:domain": "urn:solid:Entity",
  "rdfs:range": "urn:solid:Derivation",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Use to attach a `urn:solid:Derivation` resource that qualifies the basic `urn:solid:wasDerivedFrom` link with role, plan, or activity. Pattern: when you need richer derivation metadata, keep both the unqualified `wasDerivedFrom` triple (for SPARQL convenience) AND the qualified form.",
  "examples": [
    {
      "title": "Qualified derivation for a translation",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/posts/hello-de",
        "@type": "urn:solid:Entity",
        "urn:solid:wasDerivedFrom": { "@id": "https://example.org/posts/hello" },
        "urn:solid:qualifiedDerivation": { "@id": "https://example.org/derivations/translation-1" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/prov#qualifiedDerivation"
    ],
