  "@id": "urn:solid:replaces",
  "@type": "rdf:Property",
  "rdfs:label": "replaces",
  "rdfs:comment": "A related resource that the described resource supplants, displaces, or supersedes.",
  "owl:sameAs": "http://purl.org/dc/terms/replaces",
