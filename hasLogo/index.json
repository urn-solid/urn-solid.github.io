{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:hasLogo",
  "@type": "rdf:Property",
  "rdfs:label": "hasLogo",
  "rdfs:comment": "A logo image associated with the vCard — typically the brand mark of an Organization.",
  "owl:sameAs": "http://www.w3.org/2006/vcard/ns#hasLogo",
  "rdfs:seeAlso": [
    "urn:solid:hasPhoto",
    "https://schema.org/logo"
  ],
  "notToBeConfusedWith": [
    "urn:solid:hasPhoto"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Use on Organization vCards for the brand mark. Distinct from `urn:solid:hasPhoto` (typically a person's portrait). Schema.org's equivalent is `schema:logo`. Value is the logo image IRI (the deprecated `urn:solid:Logo` class has no upstream equivalent).",
  "examples": [
    {
      "title": "Organization with a logo URL",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/cards/acme",
        "@type": "urn:solid:VCard",
        "urn:solid:organization-name": "Acme Corp",
        "urn:solid:hasLogo": { "@id": "https://acme.example.org/logo.svg" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2006/vcard/ns#hasLogo"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    },
    {
      "event": "updated",
      "at": "2026-10-29T00:00:00Z",
      "by": "urn-solid-review",
      "note": "Dropped urn:solid:Logo (deprecated, no upstream class) from seeAlso and value guidance."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  }
}
