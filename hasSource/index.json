{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:hasSource",
  "@type": "rdf:Property",
  "rdfs:label": "hasSource",
  "rdfs:comment": "A source document for the vCard's information — typically a website or directory the data came from.",
  "owl:sameAs": "http://www.w3.org/2006/vcard/ns#hasSource",
  "rdfs:seeAlso": [
    "urn:solid:source",
    "urn:solid:wasDerivedFrom"
  ],
  "rdfs:domain": "urn:solid:VCard",
  "notToBeConfusedWith": [
    "urn:solid:source"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "vCard-specific source pointer — analogous to `dcterms:source` (`urn:solid:source`) but scoped to vCards and typed for the directory-import scenario. Useful when a contact card was scraped or auto-imported and you want to record the upstream URL.",
  "examples": [
    {
      "title": "vCard with an upstream source",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://example.org/cards/alice-imported",
        "@type": "urn:solid:VCard",
        "urn:solid:fn": "Alice Liddell",
        "urn:solid:hasSource": { "@id": "https://example.org/contacts/import.vcf" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2006/vcard/ns#hasSource"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
