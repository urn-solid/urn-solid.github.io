        "@type": "urn:solid:Revision",
        "http://www.w3.org/ns/prov#entity": { "@id": "https://example.org/specs/v2" },
        "http://www.w3.org/ns/prov#hadGeneration": { "@id": "https://example.org/builds/v2-publish" }
      }
    }
  ],
