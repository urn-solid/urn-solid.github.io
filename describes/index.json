  "@id": "urn:solid:describes",
  "@type": "rdf:Property",
  "rdfs:label": "describes",
  "rdfs:comment": "The Object that an ActivityStreams Profile is about — links a profile-style description to its subject.",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#describes",
  "rdfs:seeAlso": [
    "urn:solid:Profile",
    "urn:solid:Object"
  ],
  "rdfs:domain": "urn:solid:Profile",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Reciprocal of the conceptual \"profile of\" relationship: a Profile uses `as:describes` to point at the entity it documents. Lets descriptive payloads (long bios, alternate display variants) live as separate, fetchable Objects without polluting the subject's primary record.",
  "examples": [
    {
      "title": "A Profile describing a Person",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/profile/about",
        "@type": "urn:solid:Profile",
        "urn:solid:describes": { "@id": "https://alice.example.org/profile/card#me" }
      }
    }
  ],
