{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:height",
  "@type": "rdf:Property",
  "rdfs:label": "height",
  "rdfs:comment": "The height in pixels of an ActivityStreams Object — typically an Image, Video, or Link to a visual resource.",
  "owl:sameAs": "http://www.w3.org/ns/activitystreams#height",
  "rdfs:seeAlso": [
    "urn:solid:width",
    "urn:solid:Image",
    "urn:solid:Video",
    "urn:solid:Link"
  ],
  "rdfs:range": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger",
  "notToBeConfusedWith": [
    "urn:solid:width"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "In pixels, not CSS units. Pair with `as:width` so renderers can reserve layout space and avoid reflow when the image loads. For multi-resolution variants, expose each as a distinct Link with its own height/width and let clients pick.",
  "examples": [
    {
      "title": "An Image with explicit dimensions",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/photos/sunset.jpg",
        "@type": "urn:solid:Image",
        "urn:solid:width": 1920,
        "urn:solid:height": 1080
      }
    }
  ],
