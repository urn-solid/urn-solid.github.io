{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:isDefinedBy",
  "@type": "rdf:Property",
  "rdfs:label": "isDefinedBy",
  "rdfs:comment": "Points at the resource that *defines* a term — typically the vocabulary document the term was minted in.",
  "owl:sameAs": "http://www.w3.org/2000/01/rdf-schema#isDefinedBy",
  "rdfs:seeAlso": [
    "urn:solid:seeAlso",
    "urn:solid:Class",
    "urn:solid:Property"
  ],
  "notToBeConfusedWith": [
    "urn:solid:seeAlso"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "A subproperty of `rdfs:seeAlso` with a stronger claim: the target is *the source of truth* for what the term means, not just related. Each `urn:solid:*` term in this registry could (and arguably should) point at `https://urn-solid.github.io/<Name>/` via `isDefinedBy`.",
  "examples": [
    {
      "title": "A term pointing at its definition",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "urn:solid:Person",
        "urn:solid:isDefinedBy": { "@id": "https://urn-solid.github.io/Person/" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2000/01/rdf-schema#isDefinedBy"
    ],
    "curatedBy": "claude-curate-next"
  },
