{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:complementOf",
  "@type": "rdf:Property",
  "rdfs:label": "complementOf",
  "rdfs:comment": "OWL class expression: defines a class as the negation of another — instances of the new class are everything that is *not* an instance of the named class.",
  "owl:sameAs": "http://www.w3.org/2002/07/owl#complementOf",
  "rdfs:seeAlso": [
    "urn:solid:Class",
    "urn:solid:intersectionOf",
    "urn:solid:unionOf",
    "urn:solid:disjointWith"
  ],
  "rdfs:domain": "urn:solid:Class",
  "rdfs:range": "urn:solid:Class",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Logical NOT. Use sparingly — `complementOf X` is the entire universe minus X, which is rarely what you actually want. Often `disjointWith` (X has no instances in common with Y) expresses the intent more usefully than complement.",
  "examples": [
    {
      "title": "An anonymous class: not a Person",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@type": "urn:solid:Class",
        "urn:solid:complementOf": { "@id": "urn:solid:Person" }
      }
    }
  ],
