{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:hadRole",
  "@type": "rdf:Property",
  "rdfs:label": "hadRole",
  "rdfs:comment": "The role an Agent or Entity played in a qualified PROV relation — \"author\", \"editor\", \"raw input\", etc.",
  "owl:sameAs": "http://www.w3.org/ns/prov#hadRole",
  "rdfs:seeAlso": [
    "urn:solid:role",
    "http://www.w3.org/ns/prov#qualifiedAttribution",
    "http://www.w3.org/ns/prov#qualifiedAssociation"
  ],
  "notToBeConfusedWith": [
    "urn:solid:role"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Used inside qualified PROV relations to name the role taken. Distinct from `urn:solid:role` (vCard's job-title string): `hadRole` is specifically about role within an Activity or Attribution. Value is typically a `prov:Role` resource (which can be any IRI).",
  "examples": [
    {
      "title": "Attribution with a role",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/attributions/paper-42-author",
        "@type": "http://www.w3.org/ns/prov#Attribution",
        "http://www.w3.org/ns/prov#agent": { "@id": "https://example.org/alice#me" },
        "urn:solid:hadRole": { "@id": "https://example.org/roles/lead-author" }
      }
    }
  ],
  "provenance": {
