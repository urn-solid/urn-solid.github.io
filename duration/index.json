{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:duration",
  "@type": "rdf:Property",
  "rdfs:label": "duration",
  "rdfs:comment": "How long the object lasts — for time-bounded objects like events, audio, or video.",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#duration",
  "rdfs:seeAlso": [
    "https://schema.org/duration",
    "http://www.w3.org/2002/12/cal/ical#duration"
  ],
  "rdfs:range": "http://www.w3.org/2001/XMLSchema#duration",
  "status": "stable",
  "added": "2026-04-18",
  "updated": "2026-04-19",
  "notes": "An `xsd:duration` value (ISO 8601 — e.g. `\"PT3M30S\"` for 3 minutes 30 seconds). Used on Events, audio/video objects, and any time-bounded thing. For start/end points, use `urn:solid:startTime` and `urn:solid:endTime` instead.",
  "examples": [
    {
      "title": "Audio object with a duration",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/audio/podcast-42",
        "@type": "urn:solid:Audio",
        "urn:solid:duration": { "@value": "PT45M", "@type": "http://www.w3.org/2001/XMLSchema#duration" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://www.w3.org/ns/activitystreams#duration",
      "http://www.w3.org/2002/12/cal/ical#duration"
    ],
    "curatedBy": "claude-curate-next"
  },
