{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:endpointURL",
  "@type": "rdf:Property",
  "rdfs:label": "endpointURL",
  "rdfs:comment": "The root URL of a DCAT DataService — the address a client connects to to invoke the service.",
  "owl:sameAs": "http://www.w3.org/ns/dcat#endpointURL",
  "rdfs:seeAlso": [
    "urn:solid:DataService",
    "urn:solid:endpointDescription",
    "urn:solid:servesDataset"
  ],
  "rdfs:domain": "urn:solid:DataService",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Names the operational entry point. For a SPARQL endpoint, the query URL; for a REST API, the base URI. Pair with `dcat:endpointDescription` (a machine-readable description of how to talk to it — OpenAPI doc, SPARQL service description) when the service is non-trivial.",
  "examples": [
    {
      "title": "DataService exposing a SPARQL endpoint",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://data.example.org/services/sparql",
        "@type": "urn:solid:DataService",
        "urn:solid:endpointURL": { "@id": "https://data.example.org/sparql" },
        "urn:solid:servesDataset": { "@id": "https://data.example.org/dataset/main" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/dcat#endpointURL"
    ],
