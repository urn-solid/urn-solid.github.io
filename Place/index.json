{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Place",
  "@type": "rdfs:Class",
  "rdfs:label": "Place",
  "rdfs:comment": "An entity that has a somewhat fixed physical extension — a city, building, landmark, room.",
  "owl:sameAs": "https://schema.org/Place",
  "rdfs:seeAlso": [
    "https://www.w3.org/ns/activitystreams#Place",
    "http://purl.org/dc/terms/Location",
    "http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Use for any geographic feature with a roughly stable footprint. Pair with `urn:solid:hasGeo` (or `schema:geo`) for coordinates and `urn:solid:hasAddress` for postal info. In ActivityStreams/ActivityPub payloads use `as:Place` (carries `as:latitude`, `as:longitude`, `as:radius`).",
  "examples": [
    {
      "title": "A landmark",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/places/big-ben",
        "@type": "urn:solid:Place",
        "urn:solid:name": "Big Ben",
        "urn:solid:hasGeo": { "@id": "geo:51.5007,-0.1246" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://schema.org/Place"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-18T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    },
    {
      "event": "updated",
      "at": "2026-10-29T00:00:00Z",
      "by": "urn-solid-review",
      "note": "Removed non-existent dcat:Location from seeAlso (added geo:SpatialThing); corrected as:Place guidance."
    },
    {
      "event": "updated",
      "at": "2026-10-29T00:00:00Z",
      "by": "urn-solid-review",
      "note": "Added reciprocal notToBeConfusedWith links."
    }
  ],
  "see_also": {
