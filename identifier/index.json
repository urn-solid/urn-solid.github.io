{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:identifier",
  "@type": "rdf:Property",
  "rdfs:label": "identifier",
  "rdfs:comment": "An unambiguous reference to the resource within a given context.",
  "owl:sameAs": "http://purl.org/dc/terms/identifier",
  "rdfs:seeAlso": [
    "https://schema.org/identifier",
    "http://www.w3.org/ns/prov#hadIdentifier"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Use for non-URI identifiers (DOI strings, ISBN, internal IDs, UUIDs) where the resource also has a URI as its `@id`. The resource's primary identifier is its `@id`; this property records additional/secondary identifiers. Repeat to list multiple.",
  "examples": [
    {
      "title": "Article with a DOI",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://example.org/papers/42",
        "@type": "urn:solid:Document",
        "urn:solid:identifier": "10.1234/example.42"
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://purl.org/dc/terms/identifier"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-18T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    }
  ],
  "see_also": {
