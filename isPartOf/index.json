{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:isPartOf",
  "@type": "rdf:Property",
  "rdfs:label": "isPartOf",
  "rdfs:comment": "A related resource of which the described resource is a part.",
  "owl:sameAs": "http://purl.org/dc/terms/isPartOf",
  "rdfs:seeAlso": [
    "https://schema.org/isPartOf",
    "urn:solid:hasPart"
  ],
  "notToBeConfusedWith": [
    "urn:solid:hasPart"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Inverse of `urn:solid:hasPart`. Use to point at the containing resource (the book a chapter belongs to, the journal an article appears in). One value per containing whole; repeat only if the resource genuinely belongs to multiple containers.",
  "examples": [
    {
      "title": "Chapter pointing at its book",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/books/wonderland/ch1",
        "@type": "urn:solid:Document",
        "urn:solid:isPartOf": { "@id": "https://example.org/books/wonderland" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://purl.org/dc/terms/isPartOf"
    ],
    "curatedBy": "claude-curate-next"
  },
