{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:icon",
  "@type": "rdf:Property",
  "rdfs:label": "icon",
  "rdfs:comment": "A small image representing the object — typically a square avatar or favicon.",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#icon",
  "rdfs:seeAlso": [
    "urn:solid:img",
    "urn:solid:depiction",
    "https://schema.org/image",
    "https://www.w3.org/ns/activitystreams#image"
  ],
  "notToBeConfusedWith": [
    "urn:solid:img",
    "urn:solid:depiction",
    "urn:solid:image",
    "urn:solid:preview"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "ActivityStreams' small-avatar slot — typically square, low-resolution, used as the visual identifier for an actor or object in lists. The value is an Image or a URL. For a full-size or banner image in ActivityStreams use `as:image` (https://www.w3.org/ns/activitystreams#image); note `urn:solid:image` maps to schema:image. Outside AS2, foaf:img (`urn:solid:img`) / foaf:depiction (`urn:solid:depiction`) serve the portrait role.",
  "examples": [
    {
      "title": "Person with an avatar icon",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/alice#me",
        "@type": "urn:solid:Person",
        "urn:solid:icon": { "@id": "https://example.org/alice/avatar-64.png" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://www.w3.org/ns/activitystreams#icon"
    ],
    "curatedBy": "claude-curate-next"
