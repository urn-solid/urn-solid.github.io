{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:generator",
  "@type": "rdf:Property",
  "rdfs:label": "generator",
  "rdfs:comment": "The application that generated the object — typically a software client or service.",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#generator",
  "rdfs:seeAlso": [
    "urn:solid:Application",
    "urn:solid:wasGeneratedBy"
  ],
  "rdfs:range": "urn:solid:Application",
  "notToBeConfusedWith": [
    "urn:solid:wasGeneratedBy"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "ActivityStreams' \"created with\" attribution — the value is the client app (e.g. a Mastodon instance, a Solid app). Distinct from `urn:solid:wasGeneratedBy` (PROV-grade activity attribution): generator names *what software*, wasGeneratedBy names *what process run*.",
  "examples": [
    {
      "title": "Note generated by a client app",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/notes/abc",
        "@type": "urn:solid:Note",
        "urn:solid:generator": {
          "@type": "urn:solid:Application",
          "urn:solid:name": "Wonderland Web Client"
        }
      }
    }
  ],
