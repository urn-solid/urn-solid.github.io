  "@id": "urn:solid:homepage",
  "@type": "rdf:Property",
  "rdfs:label": "homepage",
  "rdfs:comment": "A homepage for some thing — the main web page about a person, organization, project or other resource. Inverse-functional: a homepage identifies at most one thing.",
  "owl:sameAs": "http://xmlns.com/foaf/0.1/homepage",
  "rdfs:seeAlso": [
    "http://www.w3.org/2006/vcard/ns#hasURL",
    "https://schema.org/url"
  ],
  "rdfs:range": "urn:solid:Document",
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Inverse-functional in FOAF: a homepage uniquely identifies its subject. Use the IRI of the actual page, not a description of it. For arbitrary URLs that are not the canonical homepage, prefer `schema:url` or `vcard:hasURL`.",
  "examples": [
    {
      "title": "Person with a homepage",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/alice#me",
        "@type": "urn:solid:Person",
        "urn:solid:homepage": { "@id": "https://alice.example.org/" }
      }
    }
  ],
