{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:SymmetricProperty",
  "@type": "rdfs:Class",
  "rdfs:label": "SymmetricProperty",
  "rdfs:comment": "An OWL property whose inverse is itself — if `A p B`, then `B p A`.",
  "owl:sameAs": "http://www.w3.org/2002/07/owl#SymmetricProperty",
  "rdfs:seeAlso": [
    "urn:solid:Property",
    "urn:solid:TransitiveProperty",
    "urn:solid:inverseOf"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Classic examples: `owl:sameAs`, `foaf:knows`, `prov:alternateOf`, `dcterms:relation`. Use for two-way relations the writer should only need to assert once. Distinct from a property that simply has a separately-named inverse (`hasPart` vs `isPartOf`) — symmetric properties *are* their own inverse.",
  "examples": [
    {
      "title": "Declaring foaf:knows as symmetric",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "http://xmlns.com/foaf/0.1/knows",
        "@type": "urn:solid:SymmetricProperty"
      }
    }
  ],
