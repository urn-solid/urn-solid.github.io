{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Class",
  "@type": "rdfs:Class",
  "rdfs:label": "Class",
  "rdfs:comment": "The class of RDF classes — the meta-class whose instances are themselves classes (Person, Note, Activity, etc.).",
  "owl:sameAs": "http://www.w3.org/2000/01/rdf-schema#Class",
  "rdfs:seeAlso": [
    "urn:solid:Property",
    "urn:solid:subClassOf",
    "urn:solid:type"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Foundational RDFS term. Every class definition in this registry is `@type: rdfs:Class`. Use as the value of `@type` when declaring a new class; pair with `rdfs:subClassOf` to position it in the class hierarchy.",
  "examples": [
    {
      "title": "Declaring a custom class",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/vocab/Athlete",
        "@type": "urn:solid:Class",
        "urn:solid:subClassOf": { "@id": "urn:solid:Person" }
      }
    }
  ],
