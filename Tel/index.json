{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Tel",
  "@type": "rdfs:Class",
  "rdfs:label": "Tel",
  "rdfs:comment": "A vCard Tel resource — a structured telephone-number entry with type tags and value.",
  "owl:sameAs": "http://www.w3.org/2006/vcard/ns#Tel",
  "rdfs:seeAlso": [
    "urn:solid:hasTelephone",
    "https://schema.org/telephone"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Use as @type for the value of `urn:solid:hasTelephone` when you need typed numbers (work/home/cell/fax) or other vCard Tel sub-types. Carries `vcard:hasValue` (a `tel:` URI) and one or more sub-class types like `vcard:Voice` or `vcard:Cell`.",
  "examples": [
    {
      "title": "vCard with a typed cell phone",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/cards/alice",
        "@type": "urn:solid:VCard",
        "urn:solid:hasTelephone": {
          "@type": ["urn:solid:Tel", "http://www.w3.org/2006/vcard/ns#Cell"],
          "http://www.w3.org/2006/vcard/ns#hasValue": { "@id": "tel:+44-20-1234-5678" }
        }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2006/vcard/ns#Tel"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    }
  ],
  "see_also": {
