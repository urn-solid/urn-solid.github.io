{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Vjournal",
  "@type": "rdfs:Class",
  "rdfs:label": "Vjournal",
  "rdfs:comment": "An iCalendar journal entry — a dated note, log entry, or diary item, used to record what happened (rather than what's scheduled).",
  "owl:sameAs": "http://www.w3.org/2002/12/cal/ical#Vjournal",
  "rdfs:seeAlso": [
    "urn:solid:Vevent",
    "urn:solid:Vtodo",
    "urn:solid:Vcalendar"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Less common than `Vevent` / `Vtodo` but standard iCal. Use for time-stamped notes that don't need scheduling: meeting minutes, daily logs, diary entries. Can be associated with an event via `RELATED-TO` (after the meeting, write the journal entry that links to it).",
  "examples": [
    {
      "title": "A daily journal entry",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/journal/2026-04-19",
        "@type": "urn:solid:Vjournal",
        "urn:solid:dtstart": { "@value": "2026-04-19T00:00:00Z", "@type": "http://www.w3.org/2001/XMLSchema#dateTime" }
      }
    }
  ],
  "provenance": {
