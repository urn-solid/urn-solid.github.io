  "@id": "urn:solid:hadGeneration",
  "@type": "rdf:Property",
  "rdfs:label": "hadGeneration",
  "rdfs:comment": "Links a use of an Entity to the qualified Generation event in which that Entity was created — letting consumers reason about which version was used.",
  "owl:sameAs": "http://www.w3.org/ns/prov#hadGeneration",
  "rdfs:seeAlso": [
    "urn:solid:Entity",
    "urn:solid:wasGeneratedBy",
    "urn:solid:qualifiedUsage",
    "urn:solid:qualifiedDerivation"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Used inside qualified PROV patterns — e.g. on a `prov:Usage` instance, `prov:hadGeneration` points to the `prov:Generation` of the entity that was used. Pairs naturally with `prov:hadActivity` to fully reconstruct the lineage of a specific use.",
  "examples": [
    {
      "title": "Qualified Usage citing the source Generation",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/usage/abc",
        "@type": "http://www.w3.org/ns/prov#Usage",
        "http://www.w3.org/ns/prov#entity": { "@id": "https://example.org/dataset/v3" },
        "urn:solid:hadGeneration": { "@id": "https://example.org/generation/dataset-v3" }
      }
    }
  ],
