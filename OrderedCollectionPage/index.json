{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:OrderedCollectionPage",
  "@type": "rdfs:Class",
  "rdfs:label": "OrderedCollectionPage",
  "rdfs:comment": "A single page of an ActivityStreams OrderedCollection — the ordered analogue of CollectionPage, with members in `as:orderedItems` rather than `as:items`.",
  "owl:sameAs": "http://www.w3.org/ns/activitystreams#OrderedCollectionPage",
  "rdfs:seeAlso": [
    "urn:solid:OrderedCollection",
    "urn:solid:CollectionPage",
    "urn:solid:partOf",
    "urn:solid:orderedItems",
    "urn:solid:next",
    "urn:solid:prev"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "The standard wire format for ActivityPub outboxes, inboxes, and any Collection where chronological order matters. JSON array order is canonical; servers SHOULD preserve it across clients. Pagination follows the same `partOf`/`next`/`prev` pattern as `CollectionPage`.",
  "examples": [
    {
      "title": "An outbox page with three Activities",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://alice.example.org/outbox?page=1",
        "@type": "urn:solid:OrderedCollectionPage",
        "urn:solid:partOf": { "@id": "https://alice.example.org/outbox" },
        "urn:solid:orderedItems": [
          { "@id": "https://alice.example.org/activities/3" },
          { "@id": "https://alice.example.org/activities/2" },
          { "@id": "https://alice.example.org/activities/1" }
        ],
        "urn:solid:next": { "@id": "https://alice.example.org/outbox?page=2" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/activitystreams#OrderedCollectionPage"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  }
}
