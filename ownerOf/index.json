  "status": "stable",
  "added": "2026-04-19",
  "notes": "Inverse of `urn:solid:owner` — declared on a WebID to enumerate the pods/resources the user owns. Useful for cross-pod ownership claims and discovery. Often co-asserted with `urn:solid:storage`.",
  "examples": [
    {
      "title": "WebID claiming pod ownership",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/profile/card#me",
        "@type": "urn:solid:Person",
        "urn:solid:ownerOf": [
          { "@id": "https://alice.example.org/" },
          { "@id": "https://alice.work.example.org/" }
        ]
      }
    }
