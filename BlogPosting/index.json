    "urn:solid:Article"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Subclass of `urn:solid:Article`. Use specifically for blog entries when you want SEO/syndication semantics that distinguish them from news or scholarly articles. Pair with `schema:isPartOf` pointing at the parent `schema:Blog`.",
  "examples": [
    {
      "title": "A blog post",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://alice.example.org/blog/hello",
        "@type": "urn:solid:BlogPosting",
        "urn:solid:headline": "Hello, blog!",
        "urn:solid:author": { "@id": "https://example.org/alice#me" },
        "urn:solid:datePublished": "2026-04-18"
      }
    }
