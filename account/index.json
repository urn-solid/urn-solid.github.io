{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:account",
  "@type": "rdf:Property",
  "rdfs:label": "account",
  "rdfs:comment": "An online account held by the subject.",
  "owl:sameAs": "http://xmlns.com/foaf/0.1/account",
  "rdfs:seeAlso": [
    "http://www.w3.org/ns/solid/terms#account"
  ],
  "rdfs:domain": "urn:solid:Agent",
  "rdfs:range": "urn:solid:OnlineAccount",
  "status": "stable",
  "added": "2026-04-18",
  "notes": "The value is an `OnlineAccount` resource describing the account (the service it lives on, the account name, etc.), not the bare account URL. For a Solid pod-specific notion of account ownership, see `solid:account`.",
  "examples": [
    {
      "title": "Person with a GitHub account",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/alice#me",
        "@type": "urn:solid:Person",
        "urn:solid:account": {
          "@type": "urn:solid:OnlineAccount",
          "urn:solid:accountName": "alice",
          "urn:solid:accountServiceHomepage": { "@id": "https://github.com/" }
        }
      }
    }
  ],
