  "added": "2026-04-18",
  "notes": "Subclass of `urn:solid:Place` (via `schema:AdministrativeArea`). Pair with `schema:containedInPlace` pointing at the containing `urn:solid:Country` to anchor it in the geographic hierarchy. For coordinates, attach `urn:solid:hasGeo`.",
  "examples": [
    {
      "title": "London as a City",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/places/london",
        "@type": "urn:solid:City",
        "urn:solid:name": "London",
        "https://schema.org/containedInPlace": { "@id": "https://example.org/places/uk" }
      }
    }
  ],
