  "@id": "urn:solid:City",
  "@type": "rdfs:Class",
  "rdfs:label": "City",
  "rdfs:comment": "A city — a permanent settlement of significant size.",
  "owl:sameAs": "https://schema.org/City",
  "rdfs:seeAlso": [
