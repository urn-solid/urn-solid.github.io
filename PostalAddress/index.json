  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Use for snail-mail addresses with structured fields (`schema:streetAddress`, `schema:addressLocality`, `schema:postalCode`, `schema:addressCountry`). Use `schema:PostalAddress` as the value of `schema:address` (schema.org data); use `urn:solid:Address` (vcard:Address) with `urn:solid:hasAddress` for vCard/SolidOS contacts.",
  "examples": [
    {
      "title": "A postal address",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/places/wonderland-hq#address",
        "@type": "urn:solid:PostalAddress",
        "https://schema.org/streetAddress": "1 Wonderland Way",
        "https://schema.org/addressLocality": "London",
        "https://schema.org/postalCode": "SW1A 1AA",
        "https://schema.org/addressCountry": "GB"
      }
    }
  ],
  "provenance": {
