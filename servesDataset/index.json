{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:servesDataset",
  "@type": "rdf:Property",
  "rdfs:label": "servesDataset",
  "rdfs:comment": "A Dataset that a DCAT DataService makes available.",
  "owl:sameAs": "http://www.w3.org/ns/dcat#servesDataset",
  "rdfs:seeAlso": [
    "urn:solid:DataService",
    "urn:solid:Dataset",
    "urn:solid:endpointURL",
    "urn:solid:accessService"
  ],
  "rdfs:domain": "urn:solid:DataService",
  "rdfs:range": "urn:solid:Dataset",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Repeat once per Dataset the service exposes — a single SPARQL endpoint or API may publish many. There is no direct inverse; from the Dataset side, link via `dcat:distribution` to a Distribution whose `urn:solid:accessService` points at this DataService.",
  "examples": [
    {
      "title": "Service serving two datasets",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://data.example.org/services/sparql",
        "@type": "urn:solid:DataService",
        "urn:solid:servesDataset": [
          { "@id": "https://data.example.org/dataset/people" },
          { "@id": "https://data.example.org/dataset/places" }
        ]
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/dcat#servesDataset"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
