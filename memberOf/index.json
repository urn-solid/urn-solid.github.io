{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:memberOf",
  "@type": "rdf:Property",
  "rdfs:label": "memberOf",
  "rdfs:comment": "An Organization the Agent is a member of.",
  "owl:sameAs": "http://www.w3.org/ns/org#memberOf",
  "rdfs:seeAlso": [
    "urn:solid:member",
    "urn:solid:Membership",
    "https://schema.org/memberOf"
  ],
  "rdfs:domain": "urn:solid:Agent",
  "notToBeConfusedWith": [
    "urn:solid:member",
    "urn:solid:hasMember",
    "urn:solid:worksFor"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Inverse of `org:hasMember` (itself a subproperty of foaf:member, i.e. `urn:solid:member`). Not to be confused with `urn:solid:hasMember`, which is vcard:hasMember (vCard group membership). Use on the Agent to enumerate the Organizations they belong to. For role-aware membership with start/end times, attach a `urn:solid:Membership` resource instead.",
  "examples": [
    {
      "title": "Person belonging to multiple orgs",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/alice#me",
        "@type": "urn:solid:Person",
        "urn:solid:memberOf": [
          { "@id": "https://example.org/orgs/acme-ltd" },
          { "@id": "https://example.org/groups/admins" }
        ]
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/org#memberOf"
    ],
    "curatedBy": "claude-curate-next"
  },
