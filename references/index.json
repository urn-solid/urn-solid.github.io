  "@id": "urn:solid:references",
  "@type": "rdf:Property",
  "rdfs:label": "references",
  "rdfs:comment": "A related resource that is referenced, cited, or otherwise pointed to by the described resource.",
  "owl:sameAs": "http://purl.org/dc/terms/references",
  "rdfs:seeAlso": [
    "https://schema.org/citation",
    "http://purl.org/dc/terms/isReferencedBy"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Use to record outbound citations or references. The inverse is `dcterms:isReferencedBy`. For richer bibliographic citations with structured metadata, prefer `dcterms:bibliographicCitation` (string) or attach a separate `dcterms:BibliographicResource`.",
  "examples": [
    {
      "title": "Article citing a source",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/papers/42",
        "@type": "urn:solid:Document",
        "urn:solid:references": { "@id": "https://example.org/papers/3" }
      }
    }
  ],
