{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:references",
  "@type": "rdf:Property",
  "rdfs:label": "references",
  "rdfs:comment": "A related resource that is referenced, cited, or otherwise pointed to by the described resource.",
  "owl:sameAs": "http://purl.org/dc/terms/references",
  "rdfs:seeAlso": [
    "https://schema.org/citation",
    "urn:solid:isReferencedBy"
  ],
  "notToBeConfusedWith": [
    "urn:solid:isReferencedBy",
    "urn:solid:bibliographicCitation"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Use for outbound references as IRIs. To give a human-readable formatted citation of *this* resource, use `urn:solid:bibliographicCitation`; to describe the cited work in detail, type it `urn:solid:BibliographicResource`. Inverse: `urn:solid:isReferencedBy`.",
  "examples": [
    {
      "title": "Article citing a source",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/papers/42",
        "@type": "urn:solid:Document",
        "urn:solid:references": { "@id": "https://example.org/papers/3" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://purl.org/dc/terms/references"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
