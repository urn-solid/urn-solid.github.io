{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Attribution",
  "@type": "rdfs:Class",
  "rdfs:label": "Attribution",
  "rdfs:comment": "A qualified PROV attribution — the role-aware relation between an Entity and the Agent it is attributed to.",
  "owl:sameAs": "http://www.w3.org/ns/prov#Attribution",
  "rdfs:seeAlso": [
    "urn:solid:wasAttributedTo",
    "urn:solid:Association",
    "urn:solid:hadRole"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Use to qualify `prov:wasAttributedTo` with a role and timing. Linked from an Entity via `prov:qualifiedAttribution`. Carries `prov:agent` (the responsible Agent) and `urn:solid:hadRole` (the role they took — author, photographer, contributor).",
  "examples": [
    {
      "title": "Photo attributed to a photographer",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/photos/sunset-attribution",
        "@type": "urn:solid:Attribution",
        "http://www.w3.org/ns/prov#agent": { "@id": "https://example.org/alice#me" },
        "urn:solid:hadRole": { "@id": "https://example.org/roles/photographer" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/prov#Attribution"
    ],
    "curatedBy": "claude-curate-next"
  },
