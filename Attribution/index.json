{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Attribution",
  "@type": "rdfs:Class",
  "rdfs:label": "Attribution",
  "rdfs:comment": "A qualified PROV attribution — the role-aware relation between an Entity and the Agent it is attributed to.",
  "owl:sameAs": "http://www.w3.org/ns/prov#Attribution",
  "rdfs:seeAlso": [
    "urn:solid:wasAttributedTo",
    "urn:solid:Association",
    "urn:solid:hadRole"
  ],
  "notToBeConfusedWith": [
    "urn:solid:Association",
    "urn:solid:attributedTo"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Use to qualify `prov:wasAttributedTo` with a role (`urn:solid:hadRole`) — author, photographer, contributor. Linked from an Entity via `urn:solid:qualifiedAttribution`; carries `prov:agent`. Has no timestamp — to record when, model the Activity (`wasGeneratedBy` + Association) instead.",
  "examples": [
    {
      "title": "Photo attributed to a photographer",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/photos/sunset-attribution",
        "@type": "urn:solid:Attribution",
        "http://www.w3.org/ns/prov#agent": { "@id": "https://example.org/alice#me" },
        "urn:solid:hadRole": { "@id": "https://example.org/roles/photographer" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/prov#Attribution"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    },
    {
      "event": "updated",
      "at": "2026-10-29T00:00:00Z",
      "by": "urn-solid-review",
      "note": "Notes: removed timing (Attribution has no time); added notToBeConfusedWith Association, attributedTo."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  }
}
