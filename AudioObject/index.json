{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:AudioObject",
  "@type": "rdfs:Class",
  "rdfs:label": "AudioObject",
  "rdfs:comment": "An audio file with structured metadata — duration, encoding, transcript.",
  "owl:sameAs": "https://schema.org/AudioObject",
  "rdfs:seeAlso": [
    "https://www.w3.org/ns/activitystreams#Audio",
    "https://schema.org/MusicRecording"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Schema.org's audio type — podcasts, voice memos, sound effects. Carries `schema:contentUrl`, `schema:duration`, `schema:encodingFormat`, `schema:transcript`. For music tracks specifically, `schema:MusicRecording` adds artist/album fields.",
  "examples": [
    {
      "title": "A podcast episode",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/podcasts/ep-42.mp3",
        "@type": "urn:solid:AudioObject",
        "https://schema.org/contentUrl": { "@id": "https://example.org/podcasts/ep-42.mp3" },
        "urn:solid:duration": "PT45M",
        "https://schema.org/encodingFormat": "audio/mpeg"
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://schema.org/AudioObject"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
