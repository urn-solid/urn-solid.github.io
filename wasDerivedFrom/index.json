{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:wasDerivedFrom",
  "@type": "rdf:Property",
  "rdfs:label": "wasDerivedFrom",
  "rdfs:comment": "An entity from which the subject entity was derived — a precursor or input.",
  "owl:sameAs": "http://www.w3.org/ns/prov#wasDerivedFrom",
  "rdfs:seeAlso": [
    "urn:solid:source",
    "https://schema.org/isBasedOn",
