    "urn:solid:wasQuotedFrom",
    "urn:solid:wasRevisionOf"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Use to record the upstream entity a derived work descends from — translations, summaries, transformed datasets. Repeat to list multiple sources. For specific kinds of derivation use the subproperties `urn:solid:wasRevisionOf`, `urn:solid:wasQuotedFrom` or `urn:solid:hadPrimarySource`; use `urn:solid:qualifiedDerivation` to add the activity/usage/generation.",
  "examples": [
    {
      "title": "Translation derived from an original",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/posts/hello-de",
        "@type": "urn:solid:Entity",
        "urn:solid:wasDerivedFrom": { "@id": "https://example.org/posts/hello" }
      }
    }
  ],
  "provenance": {
