{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:mode",
  "@type": "rdf:Property",
  "rdfs:label": "mode",
  "rdfs:comment": "An access mode granted by a Web Access Control Authorization — Read, Write, Append, or Control.",
  "owl:sameAs": "http://www.w3.org/ns/auth/acl#mode",
  "rdfs:seeAlso": [
    "urn:solid:Authorization",
    "urn:solid:Read",
    "urn:solid:Write",
    "urn:solid:Append",
    "urn:solid:Control"
  ],
  "rdfs:domain": "urn:solid:Authorization",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Repeat to grant multiple modes in one Authorization. Standard values are `acl:Read`, `acl:Write`, `acl:Append`, `acl:Control`. `Write` implies `Append`; `Control` is the meta-mode that lets the holder edit the .acl file itself.",
  "examples": [
    {
      "title": "Authorization granting Read+Write",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/notes/.acl#alice-edit",
        "@type": "urn:solid:Authorization",
        "http://www.w3.org/ns/auth/acl#agent": { "@id": "https://alice.example.org/profile/card#me" },
        "urn:solid:mode": [
          { "@id": "http://www.w3.org/ns/auth/acl#Read" },
          { "@id": "http://www.w3.org/ns/auth/acl#Write" }
        ]
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/auth/acl#mode"
    ],
    "curatedBy": "claude-curate-next"
