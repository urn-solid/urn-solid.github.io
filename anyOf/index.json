{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:anyOf",
  "@type": "rdf:Property",
  "rdfs:label": "anyOf",
  "rdfs:comment": "On an ActivityStreams Question, the inclusive set of answer choices — voters may pick any number.",
  "owl:sameAs": "http://www.w3.org/ns/activitystreams#anyOf",
  "rdfs:seeAlso": [
    "urn:solid:Question",
    "urn:solid:oneOf",
    "urn:solid:closed"
  ],
  "rdfs:domain": "urn:solid:Question",
  "notToBeConfusedWith": [
    "urn:solid:oneOf"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Multi-select counterpart to `oneOf`. Use exactly one of the two on a Question — never both. Each option is a Note whose `name` is the displayed choice; the per-option `replies.totalItems` gives that option's vote tally.",
  "examples": [
    {
      "title": "Multi-select Question",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://alice.example.org/polls/2",
        "@type": "urn:solid:Question",
        "urn:solid:content": "Which do you drink?",
        "urn:solid:anyOf": [
          { "@type": "urn:solid:Note", "urn:solid:name": "Tea" },
          { "@type": "urn:solid:Note", "urn:solid:name": "Coffee" },
          { "@type": "urn:solid:Note", "urn:solid:name": "Water" }
        ]
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/activitystreams#anyOf"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  }
}
