{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:TypeRegistration",
  "@type": "rdfs:Class",
  "rdfs:label": "TypeRegistration",
  "rdfs:comment": "An entry in a TypeIndex declaring where instances of a particular RDF class live in a Solid pod.",
  "owl:sameAs": "http://www.w3.org/ns/solid/terms#TypeRegistration",
  "rdfs:seeAlso": [
    "urn:solid:TypeIndex",
    "http://www.w3.org/ns/solid/terms#forClass",
    "http://www.w3.org/ns/solid/terms#instance",
    "http://www.w3.org/ns/solid/terms#instanceContainer"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Each TypeRegistration carries one `solid:forClass` (the RDF class) and either `solid:instance` (a single resource) or `solid:instanceContainer` (a container holding instances). Apps query the TypeIndex for registrations matching the class they need.",
  "examples": [
    {
      "title": "TypeRegistration for bookmarks",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://alice.example.org/settings/publicTypeIndex.ttl#bookmarks",
        "@type": "urn:solid:TypeRegistration",
        "http://www.w3.org/ns/solid/terms#forClass": { "@id": "http://www.w3.org/2002/01/bookmark#Bookmark" },
        "http://www.w3.org/ns/solid/terms#instanceContainer": { "@id": "https://alice.example.org/bookmarks/" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/solid/terms#TypeRegistration"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-18T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  }
}
