{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:hasURL",
  "@type": "rdf:Property",
  "rdfs:label": "hasURL",
  "rdfs:comment": "A URL associated with the subject — any web link, not necessarily the canonical homepage.",
  "owl:sameAs": "http://www.w3.org/2006/vcard/ns#hasURL",
  "rdfs:seeAlso": [
    "https://schema.org/url",
    "urn:solid:homepage"
  ],
  "notToBeConfusedWith": [
    "urn:solid:homepage"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "More general than `urn:solid:homepage` — use to enumerate any URLs (social profiles, project links, work pages). Repeat for multiple. Use `homepage` when the URL is the canonical, FOAF-style identifying homepage.",
  "examples": [
    {
      "title": "Person with multiple URLs",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/alice#me",
        "@type": "urn:solid:Person",
        "urn:solid:hasURL": [
          { "@id": "https://github.com/alice" },
          { "@id": "https://mastodon.example/@alice" }
        ]
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2006/vcard/ns#hasURL"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-18T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  }
}
