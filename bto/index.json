{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:bto",
  "@type": "rdf:Property",
  "rdfs:label": "bto",
  "rdfs:comment": "Private primary recipients of the object — \"to\" addresses hidden from other receivers.",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#bto",
  "rdfs:seeAlso": [
    "urn:solid:to",
    "urn:solid:bcc",
    "urn:solid:cc"
  ],
  "notToBeConfusedWith": [
    "urn:solid:to",
    "urn:solid:bcc"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Like `as:to` for delivery, but stripped from the object before any non-`bto` receiver sees it — use for private direct recipients you don't want exposed in the object's metadata. Same caveats as `bcc`: easily leaked by misbehaving intermediaries.",
  "examples": [
    {
      "title": "Note privately addressed",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://example.org/notes/whisper",
        "@type": "urn:solid:Note",
        "urn:solid:content": "Just for you.",
        "urn:solid:bto": [{ "@id": "https://example.org/alice#me" }]
      }
    }
  ],
