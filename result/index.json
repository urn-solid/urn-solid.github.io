{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:result",
  "@type": "rdf:Property",
  "rdfs:label": "result",
  "rdfs:comment": "Describes the result produced by an ActivityStreams Activity — for example, the booking returned by a Reservation.",
  "owl:sameAs": "http://www.w3.org/ns/activitystreams#result",
  "rdfs:seeAlso": [
    "urn:solid:Activity",
    "urn:solid:object",
    "urn:solid:target",
    "urn:solid:instrument"
  ],
  "rdfs:domain": "urn:solid:Activity",
  "notToBeConfusedWith": [
    "urn:solid:object"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "`as:result` describes what the Activity *produced*; `as:object` describes what it *acted on*. A Like activity has the liked Note as its `object` and may have nothing meaningful as its `result`; a booking activity has the requested room as `object` and the confirmed booking as `result`.",
  "examples": [
    {
      "title": "Activity with a result object",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://example.org/activities/booking-42",
        "@type": "urn:solid:Activity",
        "urn:solid:object": { "@id": "https://example.org/rooms/101" },
        "urn:solid:result": { "@id": "https://example.org/bookings/42" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/activitystreams#result"
