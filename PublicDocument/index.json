{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:PublicDocument",
  "@type": "rdfs:Class",
  "rdfs:label": "Public document",
  "rdfs:comment": "A document registered in the user's public TypeIndex — discoverable by anyone who can read the TypeIndex.",
  "owl:sameAs": "http://w3id.org/solidos#PublicDocument",
  "rdfs:seeAlso": [
    "urn:solid:publicTypeIndex",
    "urn:solid:TypeRegistration",
    "urn:solid:PrivateDocument"
  ],
  "notToBeConfusedWith": [
    "urn:solid:PrivateDocument"
  ],
  "status": "stable",
  "added": "2026-04-22",
  "notes": "Marker type for documents that should appear in (or be reachable from) a `solid:publicTypeIndex`. Pairs with `urn:solid:PrivateDocument`. Concrete instance documents typically also carry a domain-specific class (`schema:Article`, `wf:Tracker`, etc.).",
  "examples": [
    {
      "title": "Public profile page registered in the TypeIndex",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/about-me.jsonld",
        "@type": [
          "urn:solid:PublicDocument",
          "schema:AboutPage"
        ]
      }
    }
  ],
