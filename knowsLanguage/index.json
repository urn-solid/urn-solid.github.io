{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:knowsLanguage",
  "@type": "rdf:Property",
  "rdfs:label": "knowsLanguage",
  "rdfs:comment": "A language the agent (person or organization) speaks, writes, or otherwise communicates in.",
  "owl:sameAs": "https://schema.org/knowsLanguage",
  "rdfs:seeAlso": [
    "urn:solid:language",
    "urn:solid:hasLanguage"
  ],
  "rdfs:domain": "urn:solid:Agent",
  "notToBeConfusedWith": [
    "urn:solid:language",
    "urn:solid:inLanguage",
    "urn:solid:hasLanguage"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Distinct from `urn:solid:language` (which is the language of a *resource*) — `knowsLanguage` is the languages an *agent* communicates in. Value is typically a BCP 47 tag (`\"en\"`, `\"de-CH\"`) or a `schema:Language` resource. Repeat for multiple languages. schema.org domain: Person or Organization. Not `urn:solid:inLanguage`, which is the language a CreativeWork is written in.",
  "examples": [
    {
      "title": "Person fluent in two languages",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/alice#me",
        "@type": "urn:solid:Person",
        "urn:solid:knowsLanguage": [
          "en",
          "fr"
        ]
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://schema.org/knowsLanguage"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
