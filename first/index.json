{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:first",
  "@type": "rdf:Property",
  "rdfs:label": "first",
  "rdfs:comment": "The first page of a paginated ActivityStreams Collection — the entry point a client uses to start walking the pagination chain.",
  "owl:sameAs": "http://www.w3.org/ns/activitystreams#first",
  "rdfs:seeAlso": [
    "urn:solid:Collection",
    "urn:solid:last",
    "urn:solid:next",
    "urn:solid:prev",
    "urn:solid:current"
  ],
  "rdfs:domain": "urn:solid:Collection",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "On a Collection that is too large to inline, `as:first` points at a CollectionPage which can be followed via `next` (and optionally back via `prev`). For ordered collections (`as:OrderedCollection`), `first` is the chronologically/structurally earliest page; for unordered, the order is server-defined.",
  "examples": [
    {
      "title": "Paginated outbox",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://alice.example.org/outbox",
        "@type": "http://www.w3.org/ns/activitystreams#OrderedCollection",
        "urn:solid:totalItems": 5320,
        "urn:solid:first": { "@id": "https://alice.example.org/outbox?page=1" },
        "urn:solid:last": { "@id": "https://alice.example.org/outbox?page=266" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/activitystreams#first"
    ],
    "curatedBy": "claude-curate-next"
  },
