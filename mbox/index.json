{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:mbox",
  "@type": "rdf:Property",
  "rdfs:label": "mbox",
  "rdfs:comment": "A personal mailbox — typically a mailto: IRI.",
  "owl:sameAs": "http://xmlns.com/foaf/0.1/mbox",
  "rdfs:seeAlso": [
    "urn:solid:email",
    "urn:solid:hasEmail"
  ],
  "rdfs:domain": "urn:solid:Agent",
  "notToBeConfusedWith": [
    "urn:solid:email",
    "urn:solid:hasEmail",
    "urn:solid:mbox_sha1sum"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Inverse-functional in FOAF: an mbox value uniquely identifies its owner, so two agents with the same mbox are the same agent. Prefer a `mailto:` IRI as the value, not a bare string. For a plain string email use `urn:solid:email` (schema:email). For vCard-flavoured data use `urn:solid:hasEmail`.",
  "examples": [
    {
      "title": "Person with mailbox",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/alice#me",
        "@type": "urn:solid:Person",
        "urn:solid:mbox": { "@id": "mailto:alice@example.org" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://xmlns.com/foaf/0.1/mbox"
    ],
