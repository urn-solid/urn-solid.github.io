{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:orderedItems",
  "@type": "rdf:Property",
  "rdfs:label": "orderedItems",
  "rdfs:comment": "The ordered members of an ActivityStreams OrderedCollection or OrderedCollectionPage — sequence is significant.",
  "owl:sameAs": "http://www.w3.org/ns/activitystreams#orderedItems",
  "rdfs:seeAlso": [
    "urn:solid:Collection",
    "urn:solid:items",
    "urn:solid:totalItems",
    "urn:solid:first"
  ],
  "rdfs:domain": "http://www.w3.org/ns/activitystreams#OrderedCollection",
  "notToBeConfusedWith": [
    "urn:solid:items"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Use on `OrderedCollection`/`OrderedCollectionPage`; for unordered collections use `as:items`. The JSON array order is the canonical order — for a chronologically sorted outbox, that's typically newest-first. Servers paginate ordered collections via `first`/`next` just like unordered ones.",
  "examples": [
    {
      "title": "An OrderedCollectionPage with three items",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/outbox?page=1",
        "@type": "http://www.w3.org/ns/activitystreams#OrderedCollectionPage",
        "urn:solid:partOf": { "@id": "https://alice.example.org/outbox" },
        "urn:solid:orderedItems": [
          { "@id": "https://alice.example.org/activities/3" },
          { "@id": "https://alice.example.org/activities/2" },
          { "@id": "https://alice.example.org/activities/1" }
        ]
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/activitystreams#orderedItems"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  }
}
