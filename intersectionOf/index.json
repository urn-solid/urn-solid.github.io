{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:intersectionOf",
  "@type": "rdf:Property",
  "rdfs:label": "intersectionOf",
  "rdfs:comment": "OWL class expression: defines a class as the intersection of a list of other classes — instances of the new class are instances of all listed classes.",
  "owl:sameAs": "http://www.w3.org/2002/07/owl#intersectionOf",
  "rdfs:seeAlso": [
    "urn:solid:Class",
    "urn:solid:unionOf",
    "urn:solid:complementOf"
  ],
  "rdfs:domain": "urn:solid:Class",
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Logical AND across classes. Use to define \"a class of things that are both X and Y\" (e.g. an Author = Person ∩ has-published-Book). Value is an `rdf:List` of class IRIs or class expressions; reasoners use it to infer membership.",
  "examples": [
    {
      "title": "An anonymous class: Person who is also a Member",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@type": "urn:solid:Class",
        "urn:solid:intersectionOf": {
          "@list": [
            { "@id": "urn:solid:Person" },
            { "@id": "urn:solid:Member" }
          ]
        }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/2002/07/owl#intersectionOf"
    ],
