{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:Hashtag",
  "@type": "rdfs:Class",
  "rdfs:label": "Hashtag",
  "rdfs:comment": "An ActivityStreams Link representing a hashtag — a topical keyword, conventionally prefixed with `#`, attached to an Object as a tag.",
  "owl:sameAs": "http://www.w3.org/ns/activitystreams#Hashtag",
  "rdfs:seeAlso": [
    "urn:solid:Mention",
    "urn:solid:tag",
    "urn:solid:Link",
    "urn:solid:Object"
  ],
  "notToBeConfusedWith": [
    "urn:solid:Mention"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "The fediverse-canonical way to attach topic tags to a Note or Article. Use as a value of `as:tag`; the `name` carries the displayed string (with the `#`), and `href` is a URL clients can dereference for the topic feed. Mastodon and most ActivityPub servers treat this as the de facto standard.",
  "examples": [
    {
      "title": "A Note tagged with a Hashtag",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/notes/1",
        "@type": "urn:solid:Note",
        "urn:solid:content": "Just shipped the new feature! #solid",
        "urn:solid:tag": {
          "@type": "urn:solid:Hashtag",
          "urn:solid:name": "#solid",
          "urn:solid:href": { "@id": "https://alice.example.org/tags/solid" }
        }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://www.w3.org/ns/activitystreams#Hashtag"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-19T00:00:00Z",
      "by": "claude-curate-next",
      "note": "Initial term."
    }
  ],
  "see_also": {
    "corpus": "/corpus.jsonl",
    "schema": "/schema/term.schema.json",
    "index": "/index.json",
    "llms": "/llms.txt"
  }
}
