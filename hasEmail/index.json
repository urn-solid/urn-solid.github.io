{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:hasEmail",
  "@type": "rdf:Property",
  "rdfs:label": "hasEmail",
  "rdfs:comment": "An email address associated with the subject — typically a `mailto:` IRI.",
  "owl:sameAs": "http://www.w3.org/2006/vcard/ns#hasEmail",
  "rdfs:seeAlso": [
    "https://schema.org/email",
    "urn:solid:mbox"
  ],
  "notToBeConfusedWith": [
    "urn:solid:mbox"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "vCard's general email predicate: not inverse-functional and free of FOAF's strong identity semantics. Use `urn:solid:mbox` when the email uniquely identifies the agent (FOAF tradition). Multiple `hasEmail` values are typical (work, personal, etc.).",
  "examples": [
    {
      "title": "Person with email",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://example.org/alice#me",
        "@type": "urn:solid:Person",
        "urn:solid:hasEmail": { "@id": "mailto:alice@example.org" }
      }
    }
  ],
