{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:View",
  "@type": "rdfs:Class",
  "rdfs:label": "View",
  "rdfs:comment": "An ActivityStreams Activity indicating that the actor viewed the object — typically visual content (an image, a video, a page).",
  "owl:sameAs": "https://www.w3.org/ns/activitystreams#View",
  "rdfs:seeAlso": [
    "urn:solid:Listen",
    "https://www.w3.org/ns/activitystreams#Read",
    "urn:solid:Image",
    "urn:solid:Video"
  ],
  "notToBeConfusedWith": [
    "urn:solid:Read",
    "urn:solid:view"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Records consumption of visual content. Useful for read-status indicators, view-counters, recommendation signals, and analytics. Like `Listen` and `as:Read` (https://www.w3.org/ns/activitystreams#Read), it's an *event* — repeated views generate distinct Activities, not updates to a counter. Note that `urn:solid:Read` is the WAC access mode (acl:Read), not the ActivityStreams Read activity.",
  "examples": [
    {
      "title": "Viewed an image",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://alice.example.org/activities/view-7",
        "@type": "urn:solid:View",
        "urn:solid:actor": { "@id": "https://alice.example.org/profile/card#me" },
        "urn:solid:object": { "@id": "https://example.org/photos/sunset.jpg" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://www.w3.org/ns/activitystreams#View"
    ],
    "curatedBy": "claude-curate-next"
  },
