{
  "@context": "https://urn-solid.github.io/context.jsonld",
  "@id": "urn:solid:View",
  "@type": "rdfs:Class",
  "rdfs:label": "View",
  "rdfs:comment": "An ActivityStreams Activity indicating that the actor viewed the object — typically visual content (an image, a video, a page).",
  "owl:sameAs": "http://www.w3.org/ns/activitystreams#View",
  "rdfs:seeAlso": [
    "urn:solid:Listen",
    "urn:solid:Read",
    "urn:solid:Image",
    "urn:solid:Video"
  ],
  "status": "stable",
  "added": "2026-04-19",
  "notes": "Records consumption of visual content. Useful for read-status indicators, view-counters, recommendation signals, and analytics. Like `Listen` and `Read`, it's an *event* — repeated views generate distinct Activities, not updates to a counter.",
  "examples": [
    {
      "title": "Viewed an image",
      "jsonld": {
        "@context": "https://urn-solid.github.io/context.jsonld",
        "@id": "https://alice.example.org/activities/view-7",
        "@type": "urn:solid:View",
        "urn:solid:actor": { "@id": "https://alice.example.org/profile/card#me" },
        "urn:solid:object": { "@id": "https://example.org/photos/sunset.jpg" }
      }
    }
  ],
