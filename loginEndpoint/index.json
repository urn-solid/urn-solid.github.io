  "@id": "urn:solid:loginEndpoint",
  "@type": "rdf:Property",
  "rdfs:label": "loginEndpoint",
  "rdfs:comment": "The URL at which a user can log in to a given Solid server (legacy server metadata, predates Solid-OIDC).",
  "owl:sameAs": "http://www.w3.org/ns/solid/terms#loginEndpoint",
  "rdfs:seeAlso": [
    "urn:solid:oidcIssuer",
    "urn:solid:logoutEndpoint"
  ],
  "notToBeConfusedWith": [
    "urn:solid:logoutEndpoint"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Legacy (2015, NSS-era) server metadata, not specific to an OpenID provider. Solid-OIDC clients use the issuer's `/.well-known/openid-configuration` `authorization_endpoint` instead.",
  "examples": [
    {
      "title": "Server with a login endpoint",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://login.example.org/",
        "urn:solid:loginEndpoint": { "@id": "https://login.example.org/login" }
      }
    }
  ],
