{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:articleBody",
  "@type": "rdf:Property",
  "rdfs:label": "articleBody",
  "rdfs:comment": "The actual body of the article — its full text content.",
  "owl:sameAs": "https://schema.org/articleBody",
  "rdfs:seeAlso": [
    "urn:solid:content"
  ],
  "rdfs:domain": "urn:solid:Article",
  "rdfs:range": "http://www.w3.org/2001/XMLSchema#string",
  "notToBeConfusedWith": [
    "urn:solid:content",
    "urn:solid:text"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Schema.org's narrow article-text predicate, distinct from `urn:solid:headline` (the title) and `urn:solid:abstract` (the summary). Plain-text body of the article (schema:Text). If you need HTML-formatted content, use `urn:solid:content` (as:content, HTML by default) or `https://schema.org/encoding` / a separate MediaObject.",
  "examples": [
    {
      "title": "Article with body text",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/posts/hello",
        "@type": "urn:solid:Article",
        "urn:solid:headline": "Hello",
        "urn:solid:articleBody": "Welcome to the urn-solid registry."
      }
    }
  ],
  "provenance": {
    "sources": [
      "https://schema.org/articleBody"
    ],
    "curatedBy": "claude-curate-next"
  },
