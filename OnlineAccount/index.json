{
  "@context": "https://urn-solid.com/context.jsonld",
  "@id": "urn:solid:OnlineAccount",
  "@type": "rdfs:Class",
  "rdfs:label": "OnlineAccount",
  "rdfs:comment": "An account held by an Agent on some online service.",
  "owl:sameAs": "http://xmlns.com/foaf/0.1/OnlineAccount",
  "rdfs:seeAlso": [
    "urn:solid:Account"
  ],
  "notToBeConfusedWith": [
    "urn:solid:Account"
  ],
  "status": "stable",
  "added": "2026-04-18",
  "notes": "Use as the value type of `urn:solid:account`. Typically described with `urn:solid:accountName` (the username) and `urn:solid:accountServiceHomepage` (the service's homepage). urn:solid:Account is the Solid server account (login/pod owner), not an arbitrary third-party service account.",
  "examples": [
    {
      "title": "An OnlineAccount on a service",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/alice/accounts/github",
        "@type": "urn:solid:OnlineAccount",
        "urn:solid:accountName": "alice",
        "urn:solid:accountServiceHomepage": { "@id": "https://github.com/" }
      }
    }
  ],
  "provenance": {
    "sources": [
      "http://xmlns.com/foaf/0.1/OnlineAccount"
    ],
    "curatedBy": "claude-curate-next"
  },
  "history": [
    {
      "event": "added",
      "at": "2026-04-18T00:00:00Z",
