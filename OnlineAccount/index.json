  "@id": "urn:solid:OnlineAccount",
  "@type": "rdfs:Class",
  "rdfs:label": "OnlineAccount",
  "rdfs:comment": "An account held by an Agent on some online service.",
  "owl:sameAs": "http://xmlns.com/foaf/0.1/OnlineAccount",
