  "added": "2026-04-18",
  "notes": "Use as the value type of `urn:solid:account`. Typically described with `foaf:accountName` (the username) and `foaf:accountServiceHomepage` (the service's homepage). For a Solid pod account specifically, see `solid:Account`.",
  "examples": [
    {
      "title": "An OnlineAccount on a service",
      "jsonld": {
        "@context": "https://urn-solid.com/context.jsonld",
        "@id": "https://example.org/alice/accounts/github",
        "@type": "urn:solid:OnlineAccount",
        "http://xmlns.com/foaf/0.1/accountName": "alice",
        "http://xmlns.com/foaf/0.1/accountServiceHomepage": { "@id": "https://github.com/" }
      }
    }
